<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_fishbowl" model="ir.ui.view">
        <field name="name">product.template.form.fishbowl</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_standard_price']//field[@name='categ_id']" position="after">
                <field name="fishbowl_part_id" groups="fishbowl_open_import.group_fishbowl_import"/>
            </xpath>
        </field>
    </record>
</odoo>
