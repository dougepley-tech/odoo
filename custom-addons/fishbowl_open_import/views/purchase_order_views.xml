<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_fishbowl" model="ir.ui.view">
        <field name="name">purchase.order.form.fishbowl</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="fishbowl_po_id" readonly="1"/>
                <field name="fishbowl_num" readonly="1"/>
                <field name="fishbowl_status_name" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
