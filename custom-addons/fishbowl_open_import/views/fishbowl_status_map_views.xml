<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fishbowl_status_map_tree" model="ir.ui.view">
        <field name="name">fishbowl.status.map.tree</field>
        <field name="model">fishbowl.status.map</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="direction"/>
                <field name="fishbowl_status_id"/>
                <field name="fishbowl_status_name"/>
                <field name="odoo_so_state"/>
                <field name="odoo_po_state"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="action_fishbowl_status_map" model="ir.actions.act_window">
        <field name="name">Fishbowl status mapping</field>
        <field name="res_model">fishbowl.status.map</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
