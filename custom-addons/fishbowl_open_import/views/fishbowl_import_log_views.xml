<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fishbowl_import_log_tree" model="ir.ui.view">
        <field name="name">fishbowl.import.log.tree</field>
        <field name="model">fishbowl.import.log</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="create_date"/>
                <field name="batch_id"/>
                <field name="operation"/>
                <field name="level"/>
                <field name="fishbowl_ref"/>
                <field name="message"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_fishbowl_import_log_form" model="ir.ui.view">
        <field name="name">fishbowl.import.log.form</field>
        <field name="model">fishbowl.import.log</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <sheet>
                    <group>
                        <field name="create_date"/>
                        <field name="batch_id"/>
                        <field name="operation"/>
                        <field name="level"/>
                        <field name="fishbowl_ref"/>
                        <field name="message"/>
                        <field name="sale_order_id"/>
                        <field name="purchase_order_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_fishbowl_import_log" model="ir.actions.act_window">
        <field name="name">Fishbowl import log</field>
        <field name="res_model">fishbowl.import.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
