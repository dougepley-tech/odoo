<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_fishbowl" model="ir.ui.view">
        <field name="name">sale.order.form.fishbowl</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='client_order_ref']" position="after">
                <field name="fishbowl_so_id" readonly="1"/>
                <field name="fishbowl_num" readonly="1"/>
                <field name="fishbowl_status_name" readonly="1"/>
                <field name="fishbowl_amount_paid" readonly="1"/>
                <field name="fishbowl_so_note" colspan="2" readonly="1" invisible="not fishbowl_so_note"/>
            </xpath>
        </field>
    </record>
</odoo>
