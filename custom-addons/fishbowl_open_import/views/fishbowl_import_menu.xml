<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root app: home launcher (web_icon + action, same pattern as iag_custom_settings). -->
    <menuitem
        id="menu_fishbowl_open_import_app"
        name="Fishbowl Import"
        action="action_fishbowl_sync_config"
        sequence="45"
        web_icon="fishbowl_open_import,static/description/icon.png"
        groups="fishbowl_open_import.group_fishbowl_import"
    />
    <!-- Top bar order: lower sequence = further left; Configuration uses a high sequence = far right. -->
    <menuitem id="menu_fishbowl_mapping" name="Mapping" parent="menu_fishbowl_open_import_app" sequence="10"/>
    <menuitem id="menu_fishbowl_import" name="Import" parent="menu_fishbowl_open_import_app" sequence="20"/>
    <menuitem id="menu_fishbowl_configuration" name="Configuration" parent="menu_fishbowl_open_import_app" sequence="100"/>

    <menuitem id="menu_fishbowl_location_map" name="Location mapping" parent="menu_fishbowl_mapping" action="action_fishbowl_location_map" sequence="10"/>
    <menuitem id="menu_fishbowl_status_map" name="Status mapping" parent="menu_fishbowl_mapping" action="action_fishbowl_status_map" sequence="20"/>

    <menuitem id="menu_fishbowl_import_log" name="Import log" parent="menu_fishbowl_import" action="action_fishbowl_import_log" sequence="10"/>
    <menuitem id="menu_fishbowl_import_master" name="Import master data" parent="menu_fishbowl_import" action="action_fishbowl_import_master_wizard" sequence="20"/>
    <menuitem id="menu_fishbowl_import_so" name="Import open sales orders" parent="menu_fishbowl_import" action="action_fishbowl_import_so_wizard" sequence="30"/>
    <menuitem id="menu_fishbowl_import_po" name="Import open purchase orders" parent="menu_fishbowl_import" action="action_fishbowl_import_po_wizard" sequence="40"/>
    <menuitem id="menu_fishbowl_import_inventory" name="Inventory sync" parent="menu_fishbowl_import" action="action_fishbowl_import_inventory_wizard" sequence="50"/>

    <menuitem id="menu_fishbowl_sync_config" name="MySQL connection" parent="menu_fishbowl_configuration" action="action_fishbowl_sync_config" sequence="10"/>
</odoo>
