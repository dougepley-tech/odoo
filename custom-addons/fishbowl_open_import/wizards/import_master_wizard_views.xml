<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fishbowl_import_master_wizard" model="ir.ui.view">
        <field name="name">fishbowl.import.master.wizard.form</field>
        <field name="model">fishbowl.import.master.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Fishbowl master data">
                <group>
                    <field name="config_id"/>
                    <field name="import_customers"/>
                    <field name="import_vendors"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
                <group invisible="not result_message">
                    <field name="result_message" nolabel="1"/>
                </group>
            </form>
        </field>
    </record>
    <record id="action_fishbowl_import_master_wizard" model="ir.actions.act_window">
        <field name="name">Fishbowl master data</field>
        <field name="res_model">fishbowl.import.master.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
