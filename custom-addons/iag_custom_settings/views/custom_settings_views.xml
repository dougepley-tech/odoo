<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_iag_custom_settings_form" model="ir.ui.view">
        <field name="name">iag.custom.settings.form</field>
        <field name="model">iag.custom.settings</field>
        <field name="arch" type="xml">
            <form string="IAG Custom Settings">
                <sheet>
                    <field name="singleton_key" invisible="1"/>
                    <field name="name" invisible="1"/>
                    <notebook>
                        <page string="Sales" name="sales">
                            <group>
                                <field
                                    name="lock_unlock_group_ids"
                                    widget="many2many_tags"
                                    options="{'no_create': True}"
                                />
                            </group>
                        </page>
                        <page string="US Check Printing" name="us_check_printing">
                            <group>
                                <field name="iag_us_check_enable_check"/>
                                <field name="iag_us_check_enable_stub"/>
                            </group>
                            <group string="Margins (pixels)">
                                <field name="iag_us_check_margin_payee"/>
                                <field name="iag_us_check_margin_memo"/>
                                <field name="iag_us_check_margin_stub_payee"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="iag_custom_settings_default" model="iag.custom.settings">
        <field name="singleton_key">1</field>
        <field name="name">IAG Custom Settings</field>
    </record>

    <record id="action_iag_custom_settings_app" model="ir.actions.act_window">
        <field name="name">IAG Custom Settings</field>
        <field name="res_model">iag.custom.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_iag_custom_settings_form"/>
        <field name="res_id" ref="iag_custom_settings_default"/>
        <field name="target">current</field>
        <field name="group_ids" eval="[(6, 0, [ref('group_iag_custom_settings_user')])]"/>
    </record>

    <menuitem
        id="menu_iag_custom_settings_app"
        name="IAG Custom Settings"
        action="action_iag_custom_settings_app"
        sequence="80"
        web_icon="iag_custom_settings,static/description/icon.png"
        groups="iag_custom_settings.group_iag_custom_settings_user"
    />
</odoo>
