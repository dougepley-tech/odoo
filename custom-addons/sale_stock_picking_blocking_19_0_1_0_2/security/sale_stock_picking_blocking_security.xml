<odoo>
    <!-- Delete old corrupted group if it exists -->
    <delete model="res.groups" search="[('name', '=', 'Release Delivery Block in Sales Orders')]"/>
    
    <!-- Create new properly configured group -->
    <record id="group_sale_delivery_block" model="res.groups">
        <field name="name">Release Delivery Block in Sales Orders</field>
        <field name="comment">The user will be able to release deliveries that have been blocked in a sale order.</field>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>
</odoo>
