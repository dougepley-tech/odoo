<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_picking_unpaid_invoice_warning_form" model="ir.ui.view">
        <field name="name">stock.picking.unpaid.invoice.warning.form</field>
        <field name="model">stock.picking.unpaid.invoice.warning</field>
        <field name="arch" type="xml">
            <form string="Unpaid Invoices Warning">
                <group>
                    <div class="alert alert-warning" role="alert" colspan="2">
                        <strong>WARNING:</strong> There are open unpaid invoices for this order.
                    </div>
                </group>
                <group>
                    <p colspan="2">
                        Do you want to ship without payment, or cancel?
                    </p>
                </group>
                <footer>
                    <button name="action_ship_without_payment" string="OK - Ship without payment" type="object" class="btn-primary"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
