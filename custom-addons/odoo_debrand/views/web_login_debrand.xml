<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Remove "Powered by Odoo" from login page footer -->
    <template id="web_login_layout_debrand" inherit_id="web.login_layout" name="Login Layout Debrand">
        <xpath expr="//div[contains(@class,'border-top')]//a[contains(@href,'odoo.com')]" position="replace"/>
    </template>

    <!-- Hide brand promotion message (Powered by Odoo badge) on frontend/portal -->
    <template id="brand_promotion_debrand" inherit_id="web.brand_promotion_message" name="Brand Promotion Message Debrand">
        <xpath expr="//t[@t-set='odoo_logo']" position="replace">
            <t t-set="odoo_logo"/>
        </xpath>
        <xpath expr="//t[@t-set='final_message']" position="replace">
            <t t-set="final_message" t-value="''"/>
        </xpath>
        <xpath expr="//t[contains(@t-out, 'final_message')]" position="replace">
            <t t-out="''"/>
        </xpath>
    </template>
</odoo>
