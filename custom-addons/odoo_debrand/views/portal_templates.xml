<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Remove "Powered by Odoo" from portal record sidebar (e.g. /my/orders, /my/invoices) -->
    <template id="portal_record_sidebar_debrand" inherit_id="portal.portal_record_sidebar" name="Portal Record Sidebar Debrand">
        <xpath expr="//div[contains(@class,'text-muted')][.//a[contains(@href,'odoo.com')]]" position="replace">
            <div class="d-none d-lg-block mt-5 small text-center text-muted"/>
        </xpath>
    </template>

    <!-- Remove Odoo documentation link from portal My Security / API Keys section -->
    <template id="portal_my_security_debrand" inherit_id="portal.portal_my_security" name="Portal My Security Debrand">
        <xpath expr="//a[contains(@href,'odoo.com/documentation')]" position="replace">
            <i title="Documentation" class="fa fa-fw o_button_icon fa-info-circle"/>
        </xpath>
    </template>
</odoo>
