<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hide "Reviewed" button on paid invoices so users don't have to review them (matches credit card flow) -->
    <record id="view_move_form_inherit_affirm_hide_reviewed_when_paid" model="ir.ui.view">
        <field name="name">account.move.form.inherit.affirm.hide.reviewed.when.paid</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Also hide when paid so users don't have to review paid invoices -->
            <xpath expr="//button[@name='button_set_checked']" position="attributes">
                <attribute name="invisible">state != 'posted' or checked or payment_state in ('paid', 'in_payment')</attribute>
            </xpath>
        </field>
    </record>
</odoo>
