<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Payment Provider: Affirm (module_id links to this module so Published stat button shows) -->
        <record id="payment_provider_affirm" model="payment.provider">
            <field name="name">Affirm</field>
            <field name="code">affirm</field>
            <field name="state">disabled</field>
            <field name="is_published">false</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="sequence">20</field>
            <field name="redirect_form_view_id" ref="affirm_form"/>
            <field name="allow_tokenization">False</field>
            <field name="module_id" ref="base.module_payment_affirm"/>
        </record>
        
        <!-- Note: Payment method is auto-created via _get_default_payment_method_codes() -->

    </data>
</odoo>
