<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mail.AttachmentList" t-inherit="mail.AttachmentList" t-inherit-mode="extension">
        <!-- Add Print icon as hover button (alongside Download, Delete) - NOT in action menu -->
        <xpath expr="//div[hasclass('o-mail-AttachmentButtons')]" position="inside">
            <button t-if="canPrint(attachment)" class="btn bg-500 w-100 h-100 o-p-1_5 d-flex ms-2 justify-content-center align-items-center shadow-sm" t-on-click.stop="() => this.onClickPrint(attachment)" title="Print">
                <i class="fa fa-print o-text-white" role="img" aria-label="Print"/>
            </button>
        </xpath>
    </t>
</templates>
