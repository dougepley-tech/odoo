<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Tree -->
  <record id="view_iag_printer_tree" model="ir.ui.view">
    <field name="name">iag.printer.tree</field>
    <field name="model">iag.printer</field>
    <field name="arch" type="xml">
      <list string="Printers" decoration-muted="status == 'offline'" decoration-danger="status == 'error'">
        <field name="name"/>
        <field name="printer_type"/>
        <field name="location"/>
        <field name="host"/>
        <field name="port"/>
        <field name="status" widget="badge"
               decoration-success="status == 'online'"
               decoration-warning="status == 'unknown'"
               decoration-danger="status in ('offline','error')"/>
        <field name="last_check"/>
        <field name="job_count" string="Jobs"/>
        <button name="action_check_status" string="Check" type="object" icon="fa-refresh"/>
        <button name="action_test_print" string="Test" type="object" icon="fa-print"/>
      </list>
    </field>
  </record>

  <!-- Form -->
  <record id="view_iag_printer_form" model="ir.ui.view">
    <field name="name">iag.printer.form</field>
    <field name="model">iag.printer</field>
    <field name="arch" type="xml">
      <form string="Printer">
        <header>
          <button name="action_check_status" string="Check Status" type="object" class="btn-secondary"/>
          <button name="action_test_print" string="Send Test Print" type="object" class="btn-primary"/>
          <field name="status" widget="statusbar" statusbar_visible="unknown,online,offline,error"/>
        </header>
        <sheet>
          <group>
            <group string="Identity">
              <field name="name"/>
              <field name="active" widget="boolean_toggle"/>
              <field name="printer_type"/>
              <field name="location"/>
            </group>
            <group string="Status">
              <field name="status" widget="badge"
                     decoration-success="status == 'online'"
                     decoration-danger="status in ('offline','error')"/>
              <field name="last_check"/>
              <field name="last_error" invisible="not last_error"/>
            </group>
          </group>

          <notebook>
            <page string="Network / Connection">
              <group invisible="printer_type not in ['zpl_raw', 'pdf_raw', 'ipp']">
                <group string="Direct Network">
                  <field name="host" placeholder="192.168.1.50"/>
                  <field name="port"/>
                  <field name="timeout"/>
                </group>
              </group>
              <group invisible="printer_type != 'pdf_cups'">
                <group string="CUPS Settings">
                  <field name="cups_name" placeholder="Exact CUPS printer name (lpstat -p)"/>
                  <field name="cups_host"/>
                  <field name="cups_port"/>
                </group>
              </group>
            </page>
            <page string="Paper &amp; Format">
              <group>
                <field name="paper_format"/>
                <field name="dpi"/>
                <field name="copies"/>
              </group>
            </page>
            <page string="Print Jobs">
              <field name="job_ids" readonly="1">
                <list decoration-danger="state == 'failed'" decoration-success="state == 'done'">
                  <field name="create_date" string="Time"/>
                  <field name="name"/>
                  <field name="res_name"/>
                  <field name="copies"/>
                  <field name="size_bytes" string="Bytes"/>
                  <field name="state" widget="badge"
                         decoration-success="state == 'done'"
                         decoration-danger="state == 'failed'"/>
                  <field name="error_message" optional="hide"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Action -->
  <record id="action_iag_printer" model="ir.actions.act_window">
    <field name="name">Printers</field>
    <field name="res_model">iag.printer</field>
    <field name="view_mode">list,form</field>
  </record>

</odoo>
