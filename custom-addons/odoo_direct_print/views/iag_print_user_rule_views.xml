<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_iag_print_user_rule_tree" model="ir.ui.view">
    <field name="name">iag.print.user.rule.tree</field>
    <field name="model">iag.print.user.rule</field>
    <field name="arch" type="xml">
      <list string="User Printer Rules" editable="bottom">
        <field name="user_id"/>
        <field name="report_id"/>
        <field name="printer_id"/>
        <field name="copies"/>
      </list>
    </field>
  </record>

  <record id="action_iag_print_user_rule" model="ir.actions.act_window">
    <field name="name">User Printer Rules</field>
    <field name="res_model">iag.print.user.rule</field>
    <field name="view_mode">list</field>
  </record>

</odoo>
