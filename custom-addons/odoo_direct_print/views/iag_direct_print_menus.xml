<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="action_iag_print_app" model="ir.actions.act_url">
    <field name="name">Print Client (Web App)</field>
    <field name="url">/iag/print/app</field>
    <field name="target">new</field>
  </record>

  <menuitem id="menu_iag_direct_print_root"
            name="Direct Print"
            sequence="90"/>

  <menuitem id="menu_iag_print_app"
            name="Print Client"
            parent="menu_iag_direct_print_root"
            action="action_iag_print_app"
            sequence="5"/>

  <menuitem id="menu_iag_printers"
            name="Printers"
            parent="menu_iag_direct_print_root"
            action="action_iag_printer"
            sequence="10"/>

  <menuitem id="menu_iag_scenarios"
            name="Auto-Print Scenarios"
            parent="menu_iag_direct_print_root"
            action="action_iag_print_scenario"
            sequence="20"/>

  <menuitem id="menu_iag_user_rules"
            name="User Printer Rules"
            parent="menu_iag_direct_print_root"
            action="action_iag_print_user_rule"
            sequence="30"/>

  <menuitem id="menu_iag_print_log"
            name="Print Log"
            parent="menu_iag_direct_print_root"
            action="action_iag_print_job"
            sequence="40"/>

</odoo>
