<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_iag_print_scenario_tree" model="ir.ui.view">
    <field name="name">iag.print.scenario.tree</field>
    <field name="model">iag.print.scenario</field>
    <field name="arch" type="xml">
      <list string="Print Scenarios" decoration-muted="not active">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="trigger_event"/>
        <field name="report_id"/>
        <field name="printer_id"/>
        <field name="copies"/>
        <field name="active" widget="boolean_toggle"/>
        <field name="run_count" string="Runs"/>
        <field name="last_run"/>
      </list>
    </field>
  </record>

  <record id="view_iag_print_scenario_form" model="ir.ui.view">
    <field name="name">iag.print.scenario.form</field>
    <field name="model">iag.print.scenario</field>
    <field name="arch" type="xml">
      <form string="Print Scenario">
        <sheet>
          <group>
            <group string="Scenario">
              <field name="name"/>
              <field name="active" widget="boolean_toggle"/>
              <field name="sequence"/>
            </group>
            <group string="Stats">
              <field name="run_count" readonly="1"/>
              <field name="last_run" readonly="1"/>
            </group>
          </group>
          <group string="Trigger">
            <field name="trigger_event"/>
            <field name="domain_filter" placeholder='e.g. [("picking_type_code","=","outgoing")]'/>
          </group>
          <group string="Print Action">
            <field name="report_id"/>
            <field name="report_xml_id" readonly="1"/>
            <field name="printer_id"/>
            <field name="copies"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_iag_print_scenario" model="ir.actions.act_window">
    <field name="name">Print Scenarios</field>
    <field name="res_model">iag.print.scenario</field>
    <field name="view_mode">list,form</field>
  </record>

</odoo>
