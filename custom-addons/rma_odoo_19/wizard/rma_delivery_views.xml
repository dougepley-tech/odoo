<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rma_delivery_wizard_view_form" model="ir.ui.view">
        <field name="name">rma.delivery.wizard.view.form</field>
        <field name="model">rma.delivery.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="type" invisible="1"/>
                    <field name="rma_count" invisible="1"/>
                    <field name="product_id"
                           invisible="type != 'replace'"
                           required="type == 'replace'"/>
                    <field name="product_uom_qty"
                           invisible="rma_count != 1"/>
                    <field name="product_uom"
                           invisible="rma_count != 1"/>
                    <field name="scheduled_date"/>
                    <field name="warehouse_id"/>
                    <field name="rma_return_grouping"/>
                </group>
                <footer>
                    <button name="action_deliver" type="object"
                            string="Confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="rma_delivery_wizard_action" model="ir.actions.act_window">
        <field name="name">RMA Delivery</field>
        <field name="res_model">rma.delivery.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
