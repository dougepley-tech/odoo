<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Shippo rate wizard: add "Apply to Credit Note" when opened from credit note -->
    <record id="view_shippo_rate_wizard_form_rma" model="ir.ui.view">
        <field name="name">shippo.rate.wizard.form.rma</field>
        <field name="model">shippo.rate.wizard</field>
        <field name="inherit_id" ref="delivery_shippo_iag.view_shippo_rate_wizard_form"/>
        <field name="arch" type="xml">
            <field name="picking_id" position="after">
                <field name="credit_note_id" invisible="1"/>
                <field name="rma_id" invisible="1"/>
            </field>
            <xpath expr="//button[@name='action_apply_estimate']" position="after">
                <button name="action_apply_to_credit_note"
                        string="Apply to Credit Note"
                        type="object"
                        class="btn-primary"
                        invisible="not credit_note_id or state != 'rates' or not selected_rate_id"/>
            </xpath>
        </field>
    </record>
</odoo>
