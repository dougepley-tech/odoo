<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_rma_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>RMA: <span t-field="o.name"/></h2>
                        <div class="row mt32 mb32">
                            <div class="col-6">
                                <strong>Customer:</strong>
                                <span t-field="o.partner_id"/>
                                <br/>
                                <strong>Date:</strong>
                                <span t-field="o.date"/>
                                <br/>
                                <strong>Source:</strong>
                                <span t-field="o.origin"/>
                            </div>
                            <div class="col-6">
                                <strong>Operation:</strong>
                                <span t-field="o.operation_id"/>
                                <br/>
                                <strong>Reason:</strong>
                                <span t-field="o.reason_id"/>
                                <br/>
                                <strong>State:</strong>
                                <span t-field="o.state"/>
                            </div>
                        </div>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Quantity</th>
                                    <th>UoM</th>
                                    <th>Restocking Fee</th>
                                    <th>Shipping Cost</th>
                                    <th>Net Refund</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><span t-field="o.product_id"/></td>
                                    <td><span t-field="o.product_uom_qty"/></td>
                                    <td><span t-field="o.product_uom"/></td>
                                    <td><span t-field="o.restocking_fee_amount"/></td>
                                    <td><span t-field="o.return_shipping_cost"/></td>
                                    <td><strong><span t-field="o.net_refund_amount"/></strong></td>
                                </tr>
                            </tbody>
                        </table>
                        <t t-if="o.description">
                            <h4>Notes</h4>
                            <div t-field="o.description"/>
                        </t>
                        <t t-if="o.return_tracking_number">
                            <p>
                                <strong>Return Tracking:</strong>
                                <span t-field="o.return_tracking_number"/>
                            </p>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
