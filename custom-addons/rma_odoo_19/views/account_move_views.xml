<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_move_line_view_form_rma" model="ir.ui.view">
        <field name="name">account.move.line.view.form.rma</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']"
                   position="after">
                <field name="rma_id" optional="hide"/>
            </xpath>
            <!-- Credit notes: show Disc.% column so unit price, discount, and amount are visible -->
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='discount']"
                   position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_open_generate_return_label"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-truck"
                        invisible="move_type != 'out_refund' or state != 'draft'"
                        string="Generate Return Label"/>
            </xpath>
            <!-- Credit notes: hide document preview so right column shows chatter only -->
            <xpath expr="//div[hasclass('o_attachment_preview')]" position="attributes">
                <attribute name="invisible">move_type not in ('out_invoice', 'in_invoice', 'in_refund') or state != 'draft' or move_type == 'out_refund'</attribute>
            </xpath>
        </field>
    </record>

</odoo>
