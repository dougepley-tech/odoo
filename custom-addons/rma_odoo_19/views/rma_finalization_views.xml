<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rma_finalization_view_form" model="ir.ui.view">
        <field name="name">rma.finalization.view.form</field>
        <field name="model">rma.finalization</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="rma_finalization_view_list" model="ir.ui.view">
        <field name="name">rma.finalization.view.list</field>
        <field name="model">rma.finalization</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="rma_finalization_action" model="ir.actions.act_window">
        <field name="name">Finalization Reasons</field>
        <field name="res_model">rma.finalization</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
