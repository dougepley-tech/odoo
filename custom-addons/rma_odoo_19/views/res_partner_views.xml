<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_partner_view_form_rma" model="ir.ui.view">
        <field name="name">res.partner.view.form.rma</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_rma" type="object"
                        class="oe_stat_button" icon="fa-undo"
                        invisible="rma_count == 0">
                    <field name="rma_count" widget="statinfo" string="RMAs"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
