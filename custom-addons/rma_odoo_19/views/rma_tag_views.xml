<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rma_tag_view_form" model="ir.ui.view">
        <field name="name">rma.tag.view.form</field>
        <field name="model">rma.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="is_public"/>
                        <field name="color" widget="color_picker"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="rma_tag_view_list" model="ir.ui.view">
        <field name="name">rma.tag.view.list</field>
        <field name="model">rma.tag</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="is_public"/>
            </list>
        </field>
    </record>

    <record id="rma_tag_action" model="ir.actions.act_window">
        <field name="name">RMA Tags</field>
        <field name="res_model">rma.tag</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
