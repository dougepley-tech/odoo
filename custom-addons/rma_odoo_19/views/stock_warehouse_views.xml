<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_warehouse_view_form_rma" model="ir.ui.view">
        <field name="name">stock.warehouse.view.form.rma</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='warehouse_config']" position="inside">
                <group string="RMA" name="rma_config">
                    <field name="rma"/>
                    <field name="rma_loc_id" invisible="not rma"/>
                    <field name="rma_in_type_id" invisible="not rma"/>
                    <field name="rma_out_type_id" invisible="not rma"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
