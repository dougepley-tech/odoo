<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- RMA Form View -->
    <record id="rma_view_form" model="ir.ui.view">
        <field name="name">rma.view.form</field>
        <field name="model">rma</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_create_receipt" type="object"
                            string="Create Receipt"
                            class="btn-primary"
                            invisible="not show_create_receipt"/>
                    <button name="action_refund" type="object" string="Refund"
                            class="btn-primary"
                            invisible="not show_create_refund"/>
                    <button name="action_return" type="object"
                            string="Return to customer"
                            class="btn-primary"
                            invisible="not show_create_return"/>
                    <button name="action_replace" type="object"
                            string="Replace"
                            invisible="not show_create_replace"/>
                    <button name="action_generate_return_label" type="object"
                            string="Generate Return Label"
                            class="btn-secondary"
                            invisible="state != 'draft' or return_label_generated"/>
                    <button name="action_split" type="object" string="Split"
                            invisible="not can_be_split"/>
                    <button name="action_finish" type="object" string="Finish"
                            invisible="not can_be_finished"/>
                    <button name="action_lock" type="object" string="Lock"
                            invisible="not can_be_locked"/>
                    <button name="action_unlock" type="object" string="Unlock"
                            invisible="state != 'locked'"/>
                    <button name="action_void" type="object" string="Void"
                            class="btn-secondary"
                            invisible="state in ('cancelled', 'voided', 'finished', 'refunded')"/>
                    <button name="action_draft" type="object" string="Set to Draft"
                            invisible="state not in ('cancelled', 'voided')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,received,refunded"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_receipt" type="object"
                                class="oe_stat_button" icon="fa-truck"
                                invisible="not reception_move_id">
                            <span class="o_stat_text">Receipt</span>
                        </button>
                        <button name="action_view_delivery" type="object"
                                class="oe_stat_button" icon="fa-truck"
                                invisible="delivery_picking_count == 0">
                            <field name="delivery_picking_count" widget="statinfo"
                                   string="Deliveries"/>
                        </button>
                        <button name="action_view_refund" type="object"
                                class="oe_stat_button" icon="fa-pencil-square-o"
                                invisible="not refund_id">
                            <span class="o_stat_text">Refund</span>
                        </button>
                        <button name="action_view_replacement_order" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="not replacement_order_id">
                            <span class="o_stat_text">Replacement SO</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group name="left">
                            <field name="partner_id"/>
                            <field name="order_id"/>
                            <field name="product_id"
                                   domain="allowed_product_ids and [('id', 'in', allowed_product_ids)] or [('type', '=', 'consu')]"/>
                            <field name="product_uom_qty"/>
                        </group>
                        <group name="right">
                            <field name="date"/>
                            <field name="deadline"/>
                            <field name="operation_id"
                                   domain="operation_domain"/>
                            <field name="is_cross_ship"
                                   invisible="not operation_id or not operation_id.action_create_delivery"/>
                            <field name="reason_id"/>
                            <field name="user_id"/>
                            <field name="team_id"/>
                            <field name="void_reason_id" invisible="state != 'voided'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Return Details" name="return_details">
                            <group string="Products" invisible="not kit_component_ids">
                                <field name="kit_component_ids" nolabel="1" class="o_rma_products_list">
                                    <list create="0" delete="0" editable="bottom">
                                        <field name="product_id" readonly="1" width="450px"/>
                                        <field name="max_quantity" string="Delivered" readonly="1" width="90px"/>
                                        <field name="product_uom_qty" string="Quantity to Return" width="120px"/>
                                        <field name="move_id" column_invisible="1"/>
                                    </list>
                                </field>
                            </group>
                            <group>
                                <group string="Restocking Fee">
                                    <field name="restocking_fee_pct"/>
                                    <field name="no_restocking_fee"/>
                                    <field name="restocking_fee_amount"/>
                                </group>
                                <group string="Return Shipping">
                                    <field name="charge_return_shipping"/>
                                    <field name="return_shipping_cost"/>
                                    <field name="return_label_generated"/>
                                    <field name="return_tracking_number"/>
                                    <field name="return_tracking_url" widget="url"/>
                                </group>
                            </group>
                            <group>
                                <group string="Refund">
                                    <field name="refund_method"/>
                                    <field name="net_refund_amount"/>
                                </group>
                                <group string="Drop Ship">
                                    <field name="is_drop_ship"/>
                                    <field name="drop_ship_vendor_rma"
                                           invisible="not is_drop_ship"/>
                                </group>
                            </group>
                        </page>
                        <page string="Delivery / Carrier" name="delivery_carrier">
                            <group>
                                <group>
                                    <field name="carrier_id"/>
                                    <field name="reception_carrier_id"/>
                                </group>
                                <group>
                                    <field name="partner_shipping_id"/>
                                    <field name="partner_invoice_id"/>
                                    <field name="location_id"/>
                                    <field name="warehouse_id"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="description" placeholder="Add notes..."/>
                        </page>
                        <page string="Other Info" name="other">
                            <group>
                                <group>
                                    <field name="tag_ids" widget="many2many_tags"/>
                                    <field name="finalization_id"/>
                                    <field name="origin_split_rma_id"/>
                                </group>
                                <group>
                                    <field name="return_product_id"
                                           invisible="not different_return_product"/>
                                    <field name="exchange_product_id"
                                           invisible="not different_return_product"/>
                                    <field name="remaining_qty"/>
                                    <field name="delivered_qty"/>
                                    <field name="sale_line_id"/>
                                    <field name="replacement_order_id"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                    <!-- Hidden fields for computes -->
                    <field name="allowed_picking_ids" invisible="1"/>
                    <field name="allowed_move_ids" invisible="1"/>
                    <field name="allowed_product_ids" invisible="1"/>
                    <field name="operation_domain" invisible="1"/>
                    <field name="show_create_receipt" invisible="1"/>
                    <field name="show_create_return" invisible="1"/>
                    <field name="show_create_replace" invisible="1"/>
                    <field name="show_create_refund" invisible="1"/>
                    <field name="can_be_split" invisible="1"/>
                    <field name="can_be_finished" invisible="1"/>
                    <field name="can_be_locked" invisible="1"/>
                    <field name="can_be_returned" invisible="1"/>
                    <field name="can_be_replaced" invisible="1"/>
                    <field name="can_be_refunded" invisible="1"/>
                    <field name="different_return_product" invisible="1"/>
                    <field name="commercial_partner_id" invisible="1"/>
                    <field name="reception_move_id" invisible="1"/>
                    <field name="refund_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="is_rma_reason_required" invisible="1"/>
                    <field name="manual_finish_allowed" invisible="1"/>
                    <field name="replacement_order_id" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- RMA List View (Odoo 19: <list> not <tree>) -->
    <record id="rma_view_list" model="ir.ui.view">
        <field name="name">rma.view.list</field>
        <field name="model">rma</field>
        <field name="arch" type="xml">
            <list multi_edit="1" expand="0">
                <field name="name" readonly="1"/>
                <field name="date"/>
                <field name="create_date" string="Created" optional="show"/>
                <field name="partner_id"/>
                <field name="order_id" optional="show"/>
                <field name="product_id"/>
                <field name="product_uom_qty"/>
                <field name="reason_id" optional="show"/>
                <field name="operation_id"/>
                <field name="restocking_fee_pct" optional="hide"/>
                <field name="return_shipping_cost" optional="hide"/>
                <field name="refund_method" optional="hide"/>
                <field name="is_cross_ship" optional="hide"/>
                <field name="replacement_order_id" optional="hide"/>
                <field name="is_drop_ship" optional="hide"/>
                <field name="user_id" optional="show"/>
                <field name="state"
                       decoration-info="state == 'draft'"
                       decoration-warning="state in ('confirmed', 'waiting_return', 'waiting_replacement')"
                       decoration-success="state in ('received', 'refunded', 'returned', 'replaced', 'finished')"
                       decoration-muted="state in ('cancelled', 'voided', 'locked')"
                       widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- RMA Search View -->
    <record id="rma_view_search" model="ir.ui.view">
        <field name="name">rma.view.search</field>
        <field name="model">rma</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="order_id"/>
                <field name="origin"/>
                <field name="reason_id"/>
                <field name="date"/>
                <field name="create_date" string="Creation Date"/>
                <separator/>
                <filter string="Created on is in Last 30 days" name="created_last_30_days"
                        domain="[('create_date', '&gt;=', 'today -30d')]"/>
                <separator/>
                <filter string="Open" name="open"
                        domain="[('state', 'not in', ['finished', 'cancelled', 'voided'])]"
                        help="RMAs not yet finished, cancelled, or voided"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Received" name="received" domain="[('state', '=', 'received')]"/>
                <filter string="Refunded" name="refunded" domain="[('state', '=', 'refunded')]"/>
                <filter string="Waiting" name="waiting"
                        domain="[('state', 'in', ['waiting_return', 'waiting_replacement'])]"/>
                <filter string="Finished" name="finished" domain="[('state', '=', 'finished')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <filter string="Voided" name="voided" domain="[('state', '=', 'voided')]"/>
                <separator/>
                <filter string="Drop Ship" name="drop_ship" domain="[('is_drop_ship', '=', True)]"/>
                <filter string="Cross-Ship" name="cross_ship" domain="[('is_cross_ship', '=', True)]"/>
                <filter string="Store Credit" name="store_credit" domain="[('refund_method', '=', 'store_credit')]"/>
                <separator/>
                <group>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Operation" name="group_operation" context="{'group_by': 'operation_id'}"/>
                    <filter string="Reason" name="group_reason" context="{'group_by': 'reason_id'}"/>
                    <filter string="Responsible" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date'}"/>
                    <filter string="Creation Date" name="group_create_date" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- RMA Kanban View -->
    <record id="rma_view_kanban" model="ir.ui.view">
        <field name="name">rma.view.kanban</field>
        <field name="model">rma</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <templates>
                    <t t-name="card">
                        <field name="priority" widget="priority"/>
                        <div class="oe_kanban_content">
                            <strong><field name="name"/></strong>
                            <div><field name="partner_id"/></div>
                            <div><field name="product_id"/></div>
                            <div>
                                <field name="state" widget="badge"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- RMA Pivot View (reporting) -->
    <record id="rma_view_pivot" model="ir.ui.view">
        <field name="name">rma.view.pivot</field>
        <field name="model">rma</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="state" type="row"/>
                <field name="operation_id" type="row"/>
                <field name="reason_id" type="row"/>
                <field name="partner_id" type="col"/>
                <field name="user_id" type="col"/>
                <field name="date" interval="month" type="col"/>
                <field name="create_date" interval="month" type="col"/>
                <field name="product_uom_qty" type="measure"/>
                <field name="restocking_fee_amount" type="measure"/>
                <field name="return_shipping_cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- RMA Graph View (reporting) -->
    <record id="rma_view_graph" model="ir.ui.view">
        <field name="name">rma.view.graph</field>
        <field name="model">rma</field>
        <field name="arch" type="xml">
            <graph type="bar" string="RMA Analysis">
                <field name="state"/>
                <field name="product_uom_qty" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Pivot for Created/Open by Date: rows = Name, single measure = Quantity -->
    <record id="rma_view_pivot_by_date" model="ir.ui.view">
        <field name="name">rma.view.pivot.by.date</field>
        <field name="model">rma</field>
        <field name="arch" type="xml">
            <pivot string="Created RMA's by Date">
                <field name="name" type="row"/>
                <field name="product_uom_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- RMA Pivot View by Product -->
    <record id="rma_view_pivot_by_product" model="ir.ui.view">
        <field name="name">rma.view.pivot.by.product</field>
        <field name="model">rma</field>
        <field name="arch" type="xml">
            <pivot string="RMA by Product">
                <field name="product_id" type="row"/>
                <field name="state" type="row"/>
                <field name="operation_id" type="row"/>
                <field name="reason_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="create_date" interval="month" type="col"/>
                <field name="partner_id" type="col"/>
                <field name="product_uom_qty" type="measure"/>
                <field name="restocking_fee_amount" type="measure"/>
                <field name="return_shipping_cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- RMA Graph View by Product -->
    <record id="rma_view_graph_by_product" model="ir.ui.view">
        <field name="name">rma.view.graph.by.product</field>
        <field name="model">rma</field>
        <field name="arch" type="xml">
            <graph type="bar" string="RMA by Product">
                <field name="product_id"/>
                <field name="product_uom_qty" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- RMA Action -->
    <record id="rma_action" model="ir.actions.act_window">
        <field name="name">RMAs</field>
        <field name="res_model">rma</field>
        <field name="view_mode">list,form,kanban,pivot,graph</field>
        <field name="search_view_id" ref="rma_view_search"/>
        <field name="context">{'search_default_draft': 1, 'pivot_row_groupby': ['state'], 'pivot_column_groupby': ['partner_id']}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new RMA
            </p>
        </field>
    </record>

    <!-- RMA Reporting Action (opens in pivot by default, collapsed) -->
    <record id="rma_reporting_action" model="ir.actions.act_window">
        <field name="name">RMA Analysis</field>
        <field name="res_model">rma</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="rma_view_search"/>
        <field name="context">{'pivot_row_groupby': ['state'], 'pivot_column_groupby': ['partner_id']}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No RMA data yet. Create RMAs to analyze volumes, amounts, and trends.
            </p>
        </field>
    </record>

    <!-- RMA Reporting: created within date range (default last 30 days) -->
    <record id="rma_reporting_created_action" model="ir.actions.act_window">
        <field name="name">Created RMA's by Date</field>
        <field name="res_model">rma</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="view_id" ref="rma_view_pivot_by_date"/>
        <field name="search_view_id" ref="rma_view_search"/>
        <field name="context">{'pivot_row_groupby': ['name'], 'pivot_column_groupby': [], 'pivot_measures': ['product_uom_qty'], 'search_default_created_last_30_days': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Use <strong>Filters</strong> and add a filter on <strong>Creation Date</strong>
                (between two dates) to see RMAs created within your date range.
            </p>
        </field>
    </record>
    <record id="rma_reporting_created_action_view_pivot" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="rma_reporting_created_action"/>
        <field name="view_id" ref="rma_view_pivot_by_date"/>
        <field name="view_mode">pivot</field>
        <field name="sequence">1</field>
    </record>

    <!-- RMA Reporting: open within date range (default last 30 days) -->
    <record id="rma_reporting_open_action" model="ir.actions.act_window">
        <field name="name">Open RMA's by Date</field>
        <field name="res_model">rma</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="view_id" ref="rma_view_pivot_by_date"/>
        <field name="search_view_id" ref="rma_view_search"/>
        <field name="context">{'search_default_open': 1, 'search_default_created_last_30_days': 1, 'pivot_row_groupby': ['name'], 'pivot_column_groupby': [], 'pivot_measures': ['product_uom_qty']}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                This view shows <strong>Open</strong> RMAs (not finished or cancelled).
                Use <strong>Filters</strong> and add a filter on <strong>Creation Date</strong>
                to limit to a date range.
            </p>
        </field>
    </record>
    <record id="rma_reporting_open_action_view_pivot" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="rma_reporting_open_action"/>
        <field name="view_id" ref="rma_view_pivot_by_date"/>
        <field name="view_mode">pivot</field>
        <field name="sequence">1</field>
    </record>

    <!-- RMA Reporting by Product: list (grouped by product) + pivot + graph + form (click RMA to open) -->
    <record id="rma_reporting_by_product_action" model="ir.actions.act_window">
        <field name="name">RMA by Product</field>
        <field name="res_model">rma</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="rma_view_search"/>
        <field name="context">{'search_default_open': 1, 'search_default_created_last_30_days': 1, 'group_by': 'product_id', 'pivot_row_groupby': ['product_id'], 'pivot_column_groupby': ['date:month']}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No RMA data yet. Create RMAs to see return analysis by product.
            </p>
            <p>List view is grouped by <strong>Product</strong>. Expand a product to see each RMA; click an RMA to open it.</p>
        </field>
    </record>
    <record id="rma_reporting_by_product_action_view_list" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="rma_reporting_by_product_action"/>
        <field name="view_id" ref="rma_view_list"/>
        <field name="view_mode">list</field>
        <field name="sequence">1</field>
    </record>
    <record id="rma_reporting_by_product_action_view_pivot" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="rma_reporting_by_product_action"/>
        <field name="view_id" ref="rma_view_pivot_by_product"/>
        <field name="view_mode">pivot</field>
        <field name="sequence">2</field>
    </record>
    <record id="rma_reporting_by_product_action_view_graph" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="rma_reporting_by_product_action"/>
        <field name="view_id" ref="rma_view_graph_by_product"/>
        <field name="view_mode">graph</field>
        <field name="sequence">3</field>
    </record>
    <record id="rma_reporting_by_product_action_view_form" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="rma_reporting_by_product_action"/>
        <field name="view_id" ref="rma_view_form"/>
        <field name="view_mode">form</field>
        <field name="sequence">4</field>
    </record>

</odoo>
