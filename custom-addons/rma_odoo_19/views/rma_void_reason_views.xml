<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rma_void_reason_view_form" model="ir.ui.view">
        <field name="name">rma.void.reason.view.form</field>
        <field name="model">rma.void.reason</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="rma_void_reason_view_list" model="ir.ui.view">
        <field name="name">rma.void.reason.view.list</field>
        <field name="model">rma.void.reason</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="rma_void_reason_action" model="ir.actions.act_window">
        <field name="name">Void Reasons</field>
        <field name="res_model">rma.void.reason</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a void reason (e.g. Duplicate RMA, Entered in Error).
            </p>
            <p>
                Void reasons are required when voiding an RMA and can be managed here.
            </p>
        </field>
    </record>

</odoo>
