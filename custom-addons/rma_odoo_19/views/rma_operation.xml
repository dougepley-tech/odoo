<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rma_operation_view_form" model="ir.ui.view">
        <field name="name">rma.operation.view.form</field>
        <field name="model">rma.operation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Operation Name"/></h1>
                    </div>
                    <group>
                        <group string="Receipt">
                            <field name="action_create_receipt"/>
                            <field name="auto_confirm_reception"/>
                            <field name="different_return_product"/>
                        </group>
                        <group string="Delivery">
                            <field name="action_create_delivery"/>
                            <field name="prevent_delivery_grouping"/>
                        </group>
                    </group>
                    <group>
                        <group string="Refund">
                            <field name="action_create_refund"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="rma_operation_view_list" model="ir.ui.view">
        <field name="name">rma.operation.view.list</field>
        <field name="model">rma.operation</field>
        <field name="arch" type="xml">
            <list default_order="sequence, name">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="action_create_receipt"/>
                <field name="action_create_delivery"/>
                <field name="action_create_refund"/>
            </list>
        </field>
    </record>

    <!-- Kanban dashboard for operations -->
    <record id="rma_operation_view_kanban" model="ir.ui.view">
        <field name="name">rma.operation.view.kanban</field>
        <field name="model">rma.operation</field>
        <field name="arch" type="xml">
            <kanban class="oe_background_grey o_kanban_dashboard o_rma_kanban"
                    create="false">
                <field name="name"/>
                <field name="color"/>
                <field name="count_rma_draft"/>
                <field name="count_rma_awaiting_action"/>
                <field name="count_rma_processed"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="#{!selection_mode ? kanban_color(record.color.raw_value) : ''}">
                            <div class="o_kanban_card_header">
                                <div class="o_kanban_card_header_title">
                                    <div class="o_primary">
                                        <a type="object" name="get_action_all_rma">
                                            <field name="name"/>
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="container o_kanban_card_content">
                                <div class="row">
                                    <div class="col-6 o_kanban_primary_left">
                                        <a type="object" name="get_action_rma_tree_draft">
                                            <field name="count_rma_draft"/> Draft
                                        </a>
                                    </div>
                                    <div class="col-6 o_kanban_primary_right">
                                        <a type="object" name="get_action_rma_tree_awaiting_action">
                                            <field name="count_rma_awaiting_action"/> Awaiting
                                        </a>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-6">
                                        <a type="object" name="get_action_rma_tree_processed">
                                            <field name="count_rma_processed"/> Processed
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="rma_operation_action" model="ir.actions.act_window">
        <field name="name">RMA Operations</field>
        <field name="res_model">rma.operation</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

</odoo>
