<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_view_form_rma" model="ir.ui.view">
        <field name="name">sale.order.view.form.rma</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_rma" type="object"
                        class="oe_stat_button" icon="fa-undo"
                        invisible="rma_count == 0"
                        groups="rma_odoo_19.group_rma_user">
                    <field name="rma_count" widget="statinfo" string="RMAs"/>
                </button>
            </xpath>
            <xpath expr="//button[@name='action_cancel']" position="after">
                <button name="action_create_rma" type="object"
                        string="Create RMA"
                        invisible="state != 'sale'"
                        class="btn-secondary"
                        groups="rma_odoo_19.group_rma_user"/>
            </xpath>
        </field>
    </record>

</odoo>
