<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Remove sale_stock "RETURN" PDF link; returns use Request Return (RMA) instead -->
    <template id="sale_order_portal_hide_delivery_return_badge"
              inherit_id="sale_stock.sale_order_portal_content_inherit_sale_stock"
              name="Sale Order Portal - hide delivery RETURN link">
        <xpath expr="//div[@t-if=&quot;picking.state == 'done'&quot;]/a[@target='_blank']"
               position="replace"/>
    </template>

    <!-- Add "Create RMA" button on portal sale order page -->
    <template id="sale_order_portal_content_rma"
              inherit_id="sale.sale_order_portal_template"
              name="Sale Order Portal - RMA Button">
        <xpath expr="//div[@id='portal_sale_content']" position="after">
            <div class="mt-3 d-print-none" t-if="sale_order.state in ('sale', 'done')">
                <a t-att-href="sale_order.get_portal_url(suffix='/rma')"
                   class="btn btn-secondary">
                    <i class="fa fa-undo"/> Request Return (RMA)
                </a>
            </div>
        </xpath>
    </template>

    <!-- After successful portal RMA submit: thank-you banner on the sales order -->
    <template id="sale_order_portal_rma_submitted_message"
              inherit_id="sale.sale_order_portal_template"
              name="Sale Order Portal - RMA submitted message">
        <xpath expr="//div[@t-if=&quot;message == 'cant_reject'&quot;]" position="after">
            <div t-if="message == 'rma_submitted'"
                 class="alert alert-success alert-dismissible d-print-none"
                 role="status">
                <button type="button" class="btn-close" data-bs-dismiss="alert"
                        aria-label="Close"/>
                Thank you for submitting a return request. Your request is being processed.
                A representative will reach out within 24-72 hours with next steps.
            </div>
        </xpath>
    </template>

</odoo>
