<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Force-update Credit Return to auto-create refund on confirm -->
    <function model="rma.operation" name="write">
        <value model="rma.operation" search="[('name', '=', 'Credit Return')]"/>
        <value eval="{'action_create_refund': 'automatic_on_confirm'}"/>
    </function>

    <!-- Replacement: auto-create credit note at confirm -->
    <function model="rma.operation" name="write">
        <value model="rma.operation" search="[('name', '=', 'Replacement')]"/>
        <value eval="{'action_create_refund': 'automatic_on_confirm'}"/>
    </function>

    <!-- Exchange / Substitution: auto-create credit note for returned product value at confirm -->
    <function model="rma.operation" name="write">
        <value model="rma.operation" search="[('name', '=', 'Exchange / Substitution')]"/>
        <value eval="{'action_create_refund': 'automatic_on_confirm'}"/>
    </function>

</odoo>
