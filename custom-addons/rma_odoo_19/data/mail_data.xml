<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mt_rma_notification" model="mail.message.subtype">
        <field name="name">RMA Notification</field>
        <field name="res_model">rma</field>
        <field name="default" eval="False"/>
        <field name="description">RMA notification</field>
    </record>

    <record id="mail_template_rma_notification" model="mail.template">
        <field name="name">RMA: Confirmation</field>
        <field name="model_id" ref="model_rma"/>
        <field name="subject">RMA {{ object.name }} Confirmed</field>
        <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p>Dear <t t-out="object.partner_id.name"/>,</p>
                <p>Your RMA <strong><t t-out="object.name"/></strong> has been confirmed.</p>
                <p>Product: <t t-out="object.product_id.display_name"/><br/>
                   Quantity: <t t-out="object.product_uom_qty"/> <t t-out="object.product_uom.name"/></p>
                <p>We will process your return as soon as possible.</p>
                <p>Thank you,<br/><t t-out="object.company_id.name"/></p>
            </div>
        </field>
    </record>

    <record id="mail_template_rma_receipt_notification" model="mail.template">
        <field name="name">RMA: Receipt Confirmation</field>
        <field name="model_id" ref="model_rma"/>
        <field name="subject">RMA {{ object.name }} - Item Received</field>
        <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p>Dear <t t-out="object.partner_id.name"/>,</p>
                <p>We have received the item(s) for your RMA <strong><t t-out="object.name"/></strong>.</p>
                <p>Our team will inspect the item(s) and process your return shortly.</p>
                <p>Thank you,<br/><t t-out="object.company_id.name"/></p>
            </div>
        </field>
    </record>

    <record id="mail_template_rma_draft_notification" model="mail.template">
        <field name="name">RMA: Draft Created</field>
        <field name="model_id" ref="model_rma"/>
        <field name="subject">RMA {{ object.name }} - Return Request Received</field>
        <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p>Dear <t t-out="object.partner_id.name"/>,</p>
                <p>We have received your return request <strong><t t-out="object.name"/></strong>.</p>
                <p>We will review your request and get back to you shortly.</p>
                <p>Thank you,<br/><t t-out="object.company_id.name"/></p>
            </div>
        </field>
    </record>

</odoo>
