<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- RMA privilege (Odoo 19 style) -->
    <record id="privilege_rma" model="res.groups.privilege">
        <field name="name">RMA</field>
        <field name="category_id" ref="base.module_category_inventory_inventory"/>
    </record>

    <!-- RMA User group -->
    <record id="group_rma_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_rma"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <!-- RMA Manager group -->
    <record id="group_rma_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_rma"/>
        <field name="implied_ids" eval="[(4, ref('group_rma_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Manual finalization group (toggled by settings) -->
    <record id="group_rma_manual_finalization" model="res.groups">
        <field name="name">RMA Manual Finalization</field>
    </record>

    <!-- Record rules -->
    <record id="rma_rule_all" model="ir.rule">
        <field name="name">RMA: all companies</field>
        <field name="model_id" ref="model_rma"/>
        <field name="domain_force">[
            '|',
            ('company_id', '=', False),
            ('company_id', 'in', company_ids),
        ]</field>
    </record>

    <record id="rma_team_rule_all" model="ir.rule">
        <field name="name">RMA Team: all companies</field>
        <field name="model_id" ref="model_rma_team"/>
        <field name="domain_force">[
            '|',
            ('company_id', '=', False),
            ('company_id', 'in', company_ids),
        ]</field>
    </record>

    <record id="rma_finalization_rule_all" model="ir.rule">
        <field name="name">RMA Finalization: all companies</field>
        <field name="model_id" ref="model_rma_finalization"/>
        <field name="domain_force">[
            '|',
            ('company_id', '=', False),
            ('company_id', 'in', company_ids),
        ]</field>
    </record>

    <record id="rma_reason_rule_all" model="ir.rule">
        <field name="name">RMA Reason: all companies</field>
        <field name="model_id" ref="model_rma_reason"/>
        <field name="domain_force">[
            '|',
            ('company_id', '=', False),
            ('company_id', 'in', company_ids),
        ]</field>
    </record>

    <record id="rma_void_reason_rule_all" model="ir.rule">
        <field name="name">RMA Void Reason: all companies</field>
        <field name="model_id" ref="model_rma_void_reason"/>
        <field name="domain_force">[
            '|',
            ('company_id', '=', False),
            ('company_id', 'in', company_ids),
        ]</field>
    </record>

    <!-- Portal access: customers see own RMAs -->
    <record id="rma_rule_portal" model="ir.rule">
        <field name="name">RMA: portal users</field>
        <field name="model_id" ref="model_rma"/>
        <field name="domain_force">[
            ('partner_id', '=', user.partner_id.id),
        ]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

</odoo>
