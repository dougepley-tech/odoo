<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_shippo_package_template_tree" model="ir.ui.view">
    <field name="name">shippo.package.template.tree</field>
    <field name="model">shippo.package.template</field>
    <field name="arch" type="xml">
      <list string="Package Templates" editable="bottom">
        <field name="name"/>
        <field name="length"/>
        <field name="width"/>
        <field name="height"/>
        <field name="distance_unit"/>
        <field name="weight_max"/>
        <field name="mass_unit"/>
      </list>
    </field>
  </record>
</odoo>
