<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_shippo_carrier_account_search" model="ir.ui.view">
    <field name="name">shippo.carrier.account.search</field>
    <field name="model">shippo.carrier.account</field>
    <field name="arch" type="xml">
      <search string="Shippo Carrier Accounts">
        <filter name="filter_your_accounts" string="Your accounts" domain="[('is_shippo_account', '=', False)]"/>
        <filter name="filter_shippo_accounts" string="Shippo accounts" domain="[('is_shippo_account', '=', True)]"/>
        <separator/>
        <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
      </search>
    </field>
  </record>
  <record id="view_shippo_carrier_account_tree" model="ir.ui.view">
    <field name="name">shippo.carrier.account.tree</field>
    <field name="model">shippo.carrier.account</field>
    <field name="arch" type="xml">
      <list string="Shippo Carrier Accounts" create="0" delete="0">
        <field name="name"/>
        <field name="carrier_display"/>
        <field name="is_shippo_account" string="Shippo account"/>
        <field name="object_id"/>
        <field name="active"/>
      </list>
    </field>
  </record>
</odoo>
