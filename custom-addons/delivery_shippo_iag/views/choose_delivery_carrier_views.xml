<?xml version="1.0" encoding="utf-8"?>
<!-- Extends Odoo 19 "Add a shipping method" wizard: add "Get Shippo Rates" when Shippo is selected.
    See Odoo 19.0 documentation: Applications > Inventory > Shipping & Receiving > Setup. -->
<odoo>
  <record id="view_choose_delivery_carrier_form_shippo" model="ir.ui.view">
    <field name="name">choose.delivery.carrier.form.shippo</field>
    <field name="model">choose.delivery.carrier</field>
    <field name="inherit_id" ref="delivery.choose_delivery_carrier_view_form"/>
    <field name="arch" type="xml">
      <!-- Hide default Odoo "Get rate" when Shippo is selected; user uses "Get Shippo Rates" instead -->
      <xpath expr="//button[@name='update_price']" position="attributes">
        <attribute name="invisible">delivery_type == 'shippo'</attribute>
      </xpath>
      <!-- Show "Get Shippo Rates" when Shipping Method is Shippo (Odoo 19 flow) -->
      <xpath expr="//field[@name='display_price']" position="after">
        <button name="action_get_shippo_rates"
                string="Get Shippo Rates"
                type="object"
                class="btn-primary"
                invisible="delivery_type != 'shippo'"/>
      </xpath>
    </field>
  </record>
</odoo>
