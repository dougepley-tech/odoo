<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Actions kept for use from Delivery Method form (e.g. many2one to origin/package, Refresh carrier accounts).
       Shippo config is no longer under Configuration menu; it is on the Shippo delivery method form. -->
  <record id="action_shippo_settings_wizard" model="ir.actions.act_window">
    <field name="name">Shippo API Settings</field>
    <field name="res_model">shippo.settings.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
  <record id="action_shippo_origin_address" model="ir.actions.act_window">
    <field name="name">Shippo Origin Addresses</field>
    <field name="res_model">shippo.origin.address</field>
    <field name="view_mode">list,form</field>
  </record>
  <record id="action_shippo_carrier_account" model="ir.actions.act_window">
    <field name="name">Shippo Carrier Accounts</field>
    <field name="res_model">shippo.carrier.account</field>
    <field name="view_mode">list</field>
  </record>
  <record id="action_shippo_package_template" model="ir.actions.act_window">
    <field name="name">Shippo Package Templates</field>
    <field name="res_model">shippo.package.template</field>
    <field name="view_mode">list</field>
  </record>
  <!-- Shippo Origin Addresses: under Inventory → Configuration so users can create/manage origins -->
  <record id="menu_shippo_origin_address_config" model="ir.ui.menu">
    <field name="name">Shippo Origin Addresses</field>
    <field name="parent_id" ref="stock.menu_stock_config_settings"/>
    <field name="action" ref="action_shippo_origin_address"/>
    <field name="sequence" type="int">50</field>
  </record>
  <!-- Remove other Shippo menus (config is on Delivery Method form). Delete children first, then parent. -->
  <delete model="ir.ui.menu" id="menu_shippo_settings"/>
  <delete model="ir.ui.menu" id="menu_shippo_origin_address"/>
  <delete model="ir.ui.menu" id="menu_shippo_carrier_account"/>
  <delete model="ir.ui.menu" id="menu_shippo_package_template"/>
  <delete model="ir.ui.menu" id="menu_shippo_root"/>
</odoo>
