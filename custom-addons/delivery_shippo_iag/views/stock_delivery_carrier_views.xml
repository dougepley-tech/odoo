<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_delivery_carrier_form_shippo" model="ir.ui.view">
    <field name="name">delivery.carrier.form.shippo</field>
    <field name="model">delivery.carrier</field>
    <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='delivery_type']" position="after">
        <group invisible="delivery_type != 'shippo'" string="Shippo API &amp; Defaults">
          <field name="shippo_test_api_key" password="True" placeholder="Used when Environment is Test (Odoo button at top)"/>
          <field name="shippo_production_api_key" password="True" placeholder="Used when Environment is Production"/>
          <field name="shippo_default_origin_id" placeholder="Select or create an origin (e.g. Westminster)"/>
          <field name="shippo_default_package_template_id" options="{'no_create': True}" context="{'formatted_display_name': True}"/>
          <field name="shippo_carrier_account_ids" widget="many2many_tags" options="{'no_create': True}"/>
          <button name="action_shippo_refresh_carrier_accounts" string="Refresh Carrier Accounts" type="object" class="btn-secondary"/>
        </group>
        <group invisible="delivery_type != 'shippo'" string="Carrier Accounts per Origin" col="2">
          <field name="shippo_origin_carrier_mapping_ids" nolabel="1" context="{'default_delivery_carrier_id': id}" colspan="2"/>
        </group>
        <group invisible="delivery_type != 'shippo'" string="Shippo Options">
          <field name="shippo_default_rate_type"/>
          <field name="shippo_label_format"/>
          <field name="shippo_default_insurance"/>
          <field name="shippo_default_delivery_type"/>
          <field name="shippo_default_signature"/>
        </group>
        <group invisible="delivery_type != 'shippo'" string="Shippo Markup">
          <field name="shippo_markup_rule_ids" nolabel="1"/>
        </group>
      </xpath>
    </field>
  </record>

  <record id="view_shippo_origin_carrier_mapping_tree" model="ir.ui.view">
    <field name="name">shippo.origin.carrier.mapping.tree</field>
    <field name="model">shippo.origin.carrier.mapping</field>
    <field name="arch" type="xml">
      <list string="Carrier Accounts per Origin" editable="bottom" create="1" delete="1">
        <field name="origin_id" placeholder="Select or create an origin"/>
        <field name="carrier_account_ids" widget="many2many_tags" options="{'no_create': True}"/>
      </list>
    </field>
  </record>
</odoo>
