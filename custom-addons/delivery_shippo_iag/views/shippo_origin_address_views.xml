<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_shippo_origin_address_form" model="ir.ui.view">
    <field name="name">shippo.origin.address.form</field>
    <field name="model">shippo.origin.address</field>
    <field name="arch" type="xml">
      <form string="Shippo Origin Address">
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="street1"/>
              <field name="street2"/>
              <field name="city"/>
              <field name="state"/>
              <field name="zip"/>
              <field name="country_id"/>
              <field name="phone"/>
            </group>
            <group>
              <field name="shippo_address_id" readonly="True"/>
              <field name="validation_message" readonly="True"/>
              <button name="action_validate_shippo_address" string="Validate with Shippo" type="object" class="btn-primary"/>
            </group>
          </group>
          <footer>
            <button name="action_validate_shippo_address" string="Validate with Shippo" type="object" class="btn-primary"/>
            <button name="action_delete" string="Delete" type="object" class="btn-danger"
                    confirm="Delete this origin address? It will be removed from Default Origin Address and Carrier Accounts per Origin where it is used."/>
          </footer>
        </sheet>
      </form>
    </field>
  </record>
  <record id="view_shippo_origin_address_tree" model="ir.ui.view">
    <field name="name">shippo.origin.address.tree</field>
    <field name="model">shippo.origin.address</field>
    <field name="arch" type="xml">
      <list string="Origin Addresses" editable="bottom" delete="1">
        <field name="name"/>
        <field name="city"/>
        <field name="state"/>
        <field name="zip"/>
        <field name="country_id"/>
        <field name="shippo_address_id"/>
      </list>
    </field>
  </record>
</odoo>
