<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_shippo_settings_wizard_form" model="ir.ui.view">
    <field name="name">shippo.settings.wizard.form</field>
    <field name="model">shippo.settings.wizard</field>
    <field name="arch" type="xml">
      <form string="Shippo API Settings">
        <group>
          <field name="shippo_test_api_key" password="True" placeholder="Used when Odoo Environment is Test"/>
          <field name="shippo_production_api_key" password="True" placeholder="Used when Odoo Environment is Production"/>
        </group>
        <footer>
          <button name="action_save" string="Save" type="object" class="btn-primary"/>
          <button name="action_refresh_carrier_accounts" string="Refresh Carrier Accounts" type="object" class="btn-secondary"/>
          <button string="Cancel" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
