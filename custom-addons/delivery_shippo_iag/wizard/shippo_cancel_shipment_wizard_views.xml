<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_shippo_cancel_shipment_wizard_form" model="ir.ui.view">
    <field name="name">shippo.cancel.shipment.wizard.form</field>
    <field name="model">shippo.cancel.shipment.wizard</field>
    <field name="arch" type="xml">
      <form string="Cancel Shippo Shipment">
        <group>
          <field name="picking_id" readonly="True"/>
        </group>
        <p>This will request a refund for the label from Shippo and clear the tracking on this delivery order.</p>
        <footer>
          <button name="action_cancel_shipment" string="Cancel Shipment" type="object" class="btn-danger"/>
          <button string="Close" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
