<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_shippo_validate_warning_wizard_form" model="ir.ui.view">
    <field name="name">shippo.validate.warning.wizard.form</field>
    <field name="model">shippo.validate.warning.wizard</field>
    <field name="arch" type="xml">
      <form string="No shipping label">
        <field name="picking_id" invisible="1"/>
        <div class="alert alert-warning" role="alert">
          <p><strong>No Shippo shipping label has been created yet.</strong></p>
          <p>This transfer has a selected delivery service but no label. Use Get Shippo Rates, pick a rate, then Generate Label if you need a label.</p>
        </div>
        <group>
          <field name="service_name"/>
        </group>
        <footer>
          <button name="action_validate_anyway" string="Validate anyway" type="object" class="btn-primary"/>
          <button string="Cancel" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
