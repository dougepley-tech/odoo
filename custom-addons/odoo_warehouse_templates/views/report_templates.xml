<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Shared: company address block with optional warehouse HTML override -->
    <template id="wh_report_company_address_ul">
        <ul class="list-unstyled wh_report_company_address" name="company_address_list">
            <li t-if="warehouse and warehouse.report_address">
                <span t-out="warehouse.report_address" style="white-space: pre-line;"/>
            </li>
            <li t-elif="warehouse and warehouse.company_details">
                <span t-field="warehouse.company_details">
                    <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 w-100 opacity-75 text-muted text-center">
                        <strong>Warehouse details</strong>
                        <div>Warehouse-specific address or details.</div>
                    </div>
                </span>
            </li>
            <li t-elif="company.is_company_details_empty">
                <span t-field="company.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'>
                    <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 w-100 opacity-75 text-muted text-center">
                        <strong>Company address block</strong>
                        <div>Contains the company address.</div>
                    </div>
                </span>
            </li>
            <li t-else="">
                <span t-field="company.company_details">
                    <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 w-100 opacity-75 text-muted text-center">
                        <strong>Company details block</strong>
                        <div>Contains the company details.</div>
                    </div>
                </span>
            </li>
            <li t-if="not forced_vat">
                <t t-if="warehouse and warehouse.document_vat">
                    <t t-esc="company.country_id.vat_label or 'Tax ID'">Tax ID</t>:
                    <span t-esc="warehouse.document_vat"/>
                </t>
                <t t-elif="company.vat">
                    <t t-esc="company.country_id.vat_label or 'Tax ID'">Tax ID</t>:
                    <span t-esc="company.vat">US12345671</span>
                </t>
            </li>
            <li t-else="">
                <t t-esc="company.country_id.vat_label or 'Tax ID'">Tax ID</t>:
                <span t-esc="forced_vat">US12345671</span>
            </li>
        </ul>
    </template>

    <!-- Prefer warehouse document template when set -->
    <template id="external_layout_warehouse" inherit_id="web.external_layout">
        <xpath expr="//t[@t-if=&quot;company.external_report_layout_id&quot;]" position="replace">
            <t t-if="warehouse and warehouse.external_report_layout_id" t-call="{{warehouse.external_report_layout_id.sudo().key}}"><t t-out="0"/></t>
            <t t-elif="company.external_report_layout_id" t-call="{{company.external_report_layout_id.sudo().key}}"><t t-out="0"/></t>
            <t t-else="" t-call="web.external_layout_standard"><t t-out="0"/></t>
        </xpath>
        <!-- Remove the original fallback now merged into the block above -->
        <xpath expr="//t[@t-else=&quot;else&quot;][@t-call=&quot;web.external_layout_standard&quot;]" position="replace"/>
    </template>

    <template id="report_layout_warehouse_css" inherit_id="web.report_layout">
        <xpath expr="//head" position="inside">
            <t t-if="report_branding_css" t-out="report_branding_css"/>
        </xpath>
        <!-- wkhtmltopdf sometimes drops or reorders head styles; duplicate in body for reliable PDF -->
        <xpath expr="//body" position="inside">
            <t t-if="report_branding_css" t-out="report_branding_css"/>
        </xpath>
    </template>

    <!-- PDF uses _prepare_html → minimal_layout re-renders each fragment; report_layout head is not kept. -->
    <template id="minimal_layout_warehouse_branding" inherit_id="web.minimal_layout">
        <xpath expr="//head" position="inside">
            <t t-if="report_branding_css" t-out="report_branding_css"/>
        </xpath>
        <xpath expr="//body" position="inside">
            <t t-if="report_branding_css" t-out="report_branding_css"/>
        </xpath>
    </template>

    <template id="external_layout_striped_wh_logo" inherit_id="web.external_layout_striped">
        <xpath expr="//img[contains(@class, 'o_company_logo_big')]" position="replace">
            <img t-if="warehouse and warehouse.logo or company.logo" class="o_company_logo_big" t-att-src="image_data_uri(warehouse.logo if warehouse and warehouse.logo else company.logo)" alt="Logo"/>
        </xpath>
        <xpath expr="//div[@t-field='company.report_header'][contains(@class, 'o_company_tagline')]" position="replace">
            <div t-if="warehouse and warehouse.report_header" t-field="warehouse.report_header" class="o_company_tagline fw-bold mt-2">Company tagline</div>
            <div t-elif="company.report_header" t-field="company.report_header" class="o_company_tagline fw-bold mt-2">Company tagline</div>
        </xpath>
        <xpath expr="//ul[@name='company_address_list']" position="replace">
            <t t-call="odoo_warehouse_templates.wh_report_company_address_ul"/>
        </xpath>
        <xpath expr="//div[contains(@class, 'o_footer_content')]//div[@t-field='company.report_footer']" position="replace">
            <div t-if="warehouse and warehouse.report_footer" t-field="warehouse.report_footer"/>
            <div t-elif="company.report_footer" t-field="company.report_footer"/>
        </xpath>
    </template>

    <template id="external_layout_boxed_wh_logo" inherit_id="web.external_layout_boxed">
        <xpath expr="//img[contains(@class, 'o_company_logo_big')]" position="replace">
            <img t-if="warehouse and warehouse.logo or company.logo" class="o_company_logo_big" t-att-src="image_data_uri(warehouse.logo if warehouse and warehouse.logo else company.logo)" alt="Logo"/>
        </xpath>
        <xpath expr="//ul[@name='company_address_list']" position="replace">
            <t t-call="odoo_warehouse_templates.wh_report_company_address_ul"/>
        </xpath>
        <xpath expr="//div[contains(@class, 'o_footer_content')]//span[@t-field='company.report_footer']" position="replace">
            <span t-if="warehouse and warehouse.report_footer" t-field="warehouse.report_footer"/>
            <span t-elif="company.report_footer" t-field="company.report_footer"/>
        </xpath>
        <xpath expr="//div[contains(@class, 'o_footer_content')]//strong[@t-field='company.report_header']" position="replace">
            <strong t-if="warehouse and warehouse.report_header and not is_html_empty(warehouse.report_header)" t-field="warehouse.report_header" class="o_company_tagline">Company tagline</strong>
            <strong t-elif="not is_html_empty(company.report_header)" t-field="company.report_header" class="o_company_tagline">Company tagline</strong>
        </xpath>
    </template>

    <template id="external_layout_bold_wh_logo" inherit_id="web.external_layout_bold">
        <xpath expr="//img[contains(@class, 'o_company_logo_big')]" position="replace">
            <img t-if="warehouse and warehouse.logo or company.logo" class="o_company_logo_big" t-att-src="image_data_uri(warehouse.logo if warehouse and warehouse.logo else company.logo)" alt="Logo"/>
        </xpath>
        <xpath expr="//ul[@name='company_address_list']" position="replace">
            <t t-call="odoo_warehouse_templates.wh_report_company_address_ul"/>
        </xpath>
        <xpath expr="//div[contains(@class, 'o_footer_content')]//span[@t-field='company.report_footer']" position="replace">
            <span t-if="warehouse and warehouse.report_footer" t-field="warehouse.report_footer"/>
            <span t-elif="company.report_footer" t-field="company.report_footer"/>
        </xpath>
        <xpath expr="//div[contains(@class, 'o_footer_content')]//strong[@t-field='company.report_header']" position="replace">
            <strong t-if="warehouse and warehouse.report_header and not is_html_empty(warehouse.report_header)" t-field="warehouse.report_header" class="o_company_tagline">Company tagline</strong>
            <strong t-elif="not is_html_empty(company.report_header)" t-field="company.report_header" class="o_company_tagline">Company tagline</strong>
        </xpath>
    </template>

    <template id="external_layout_standard_wh" inherit_id="web.external_layout_standard">
        <xpath expr="//img[contains(@class, 'o_company_logo_small')]" position="replace">
            <img t-if="warehouse and warehouse.logo or company.logo" class="o_company_logo_small" t-att-src="image_data_uri(warehouse.logo if warehouse and warehouse.logo else company.logo)" alt="Logo"/>
        </xpath>
        <xpath expr="//div[@t-field='company.report_header'][contains(@class, 'o_company_tagline')]" position="replace">
            <div t-if="warehouse and warehouse.report_header" t-field="warehouse.report_header" class="o_company_tagline mw-50 fw-bold">Company tagline</div>
            <div t-elif="company.report_header" t-field="company.report_header" class="o_company_tagline mw-50 fw-bold">Company tagline</div>
        </xpath>
        <xpath expr="//ul[@name='company_address_list']" position="replace">
            <t t-call="odoo_warehouse_templates.wh_report_company_address_ul"/>
        </xpath>
        <xpath expr="//div[contains(@class, 'o_footer_content')]//div[@t-field='company.report_footer']" position="replace">
            <div class="flex-grow-1 text-start me-2" t-if="warehouse and warehouse.report_footer" t-field="warehouse.report_footer"/>
            <div class="flex-grow-1 text-start me-2" t-elif="company.report_footer" t-field="company.report_footer"/>
        </xpath>
    </template>

    <template id="external_layout_folder_wh_logo" inherit_id="web.external_layout_folder">
        <xpath expr="//img[contains(@class, 'o_company_logo_big')]" position="replace">
            <img t-if="warehouse and warehouse.logo or company.logo" class="o_company_logo_big mb-2" t-att-src="image_data_uri(warehouse.logo if warehouse and warehouse.logo else company.logo)" alt="Logo"/>
        </xpath>
        <xpath expr="//div[@t-field='company.report_header'][contains(@class, 'o_company_tagline')]" position="replace">
            <div t-if="warehouse and warehouse.report_header" t-field="warehouse.report_header" class="o_company_tagline fw-bold">Company tagline</div>
            <div t-elif="company.report_header" t-field="company.report_header" class="o_company_tagline fw-bold">Company tagline</div>
        </xpath>
        <xpath expr="//ul[@name='company_address_list']" position="replace">
            <t t-call="odoo_warehouse_templates.wh_report_company_address_ul"/>
        </xpath>
        <xpath expr="//div[contains(@class, 'o_footer_content')]//div[@t-field='company.report_footer']" position="replace">
            <div class="flex-grow-1 me-2 text-start" t-if="warehouse and warehouse.report_footer" t-field="warehouse.report_footer"/>
            <div class="flex-grow-1 me-2 text-start" t-elif="company.report_footer" t-field="company.report_footer"/>
        </xpath>
    </template>

    <template id="external_layout_wave_wh_logo" inherit_id="web.external_layout_wave">
        <xpath expr="//img[contains(@class, 'o_company_logo')]" position="replace">
            <img t-if="warehouse and warehouse.logo or company.logo" class="o_company_logo mb-2" t-att-src="image_data_uri(warehouse.logo if warehouse and warehouse.logo else company.logo)" alt="Logo"/>
        </xpath>
        <xpath expr="//div[@t-field='company.report_header'][contains(@class, 'o_company_tagline')]" position="replace">
            <div t-if="warehouse and warehouse.report_header" t-field="warehouse.report_header" class="o_company_tagline fw-bold">Company tagline</div>
            <div t-elif="company.report_header" t-field="company.report_header" class="o_company_tagline fw-bold">Company tagline</div>
        </xpath>
        <xpath expr="//ul[@name='company_address_list']" position="replace">
            <t t-call="odoo_warehouse_templates.wh_report_company_address_ul"/>
        </xpath>
        <!-- No SVG xpaths: upstream/custom wave templates differ; table colors use report_branding_css -->
        <xpath expr="//div[contains(@t-attf-class, 'o_footer_content')]//div[@t-field='company.report_footer']" position="replace">
            <div t-if="warehouse and warehouse.report_footer" t-field="warehouse.report_footer"/>
            <div t-elif="company.report_footer" t-field="company.report_footer"/>
        </xpath>
    </template>

    <template id="external_layout_bubble_wh_logo" inherit_id="web.external_layout_bubble">
        <xpath expr="//img[contains(@class, 'o_company_logo')]" position="replace">
            <img t-if="warehouse and warehouse.logo or company.logo" class="o_company_logo mb-2" t-att-src="image_data_uri(warehouse.logo if warehouse and warehouse.logo else company.logo)" alt="Logo"/>
        </xpath>
        <!-- No SVG xpaths: upstream bubble markup varies; thead/total colors use report_branding_css -->
        <xpath expr="//div[contains(@t-attf-class, 'header') and contains(@t-attf-class, 'o_company_')]//table[contains(@class, 'o_ignore_layout_styling')]/tbody/tr/td[contains(@class, 'o_company_tagline')]" position="replace">
            <td t-if="(warehouse and warehouse.report_header) or company.report_header" class="o_company_tagline fw-bold p-0 pe-2">
                <span t-if="warehouse and warehouse.report_header" t-field="warehouse.report_header">Company tagline</span>
                <span t-elif="company.report_header" t-field="company.report_header">Company tagline</span>
            </td>
        </xpath>
        <xpath expr="//ul[@name='company_address_list']" position="replace">
            <t t-call="odoo_warehouse_templates.wh_report_company_address_ul"/>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'o_footer_content')]//div[@t-field='company.report_footer']" position="replace">
            <div class="border-top pt-2" t-if="warehouse and warehouse.report_footer" t-field="warehouse.report_footer"/>
            <div class="border-top pt-2" t-elif="company.report_footer" t-field="company.report_footer"/>
        </xpath>
    </template>
</odoo>
