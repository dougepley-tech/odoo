<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cron job for auto-syncing products - runs every 5 minutes and checks if sync is needed -->
    <record id="ir_cron_auto_sync_products" model="ir.cron">
        <field name="name">BigCommerce: Auto Sync Products</field>
        <field name="model_id" ref="bigcommerce_connector.model_bigcommerce_config"/>
        <field name="state">code</field>
        <field name="code">env['bigcommerce.config']._cron_auto_sync_products()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <!-- Cron job for auto-syncing orders - runs every 5 minutes and checks if sync is needed -->
    <record id="ir_cron_auto_sync_orders" model="ir.cron">
        <field name="name">BigCommerce: Auto Sync Orders</field>
        <field name="model_id" ref="bigcommerce_connector.model_bigcommerce_config"/>
        <field name="state">code</field>
        <field name="code">env['bigcommerce.config']._cron_auto_sync_orders()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <!-- Cron job for auto-syncing inventory - runs every 5 minutes and checks if sync is needed -->
    <record id="ir_cron_auto_sync_inventory" model="ir.cron">
        <field name="name">BigCommerce: Auto Sync Inventory</field>
        <field name="model_id" ref="bigcommerce_connector.model_bigcommerce_config"/>
        <field name="state">code</field>
        <field name="code">env['bigcommerce.config']._cron_auto_sync_inventory()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <!-- Cron job for auto-syncing customers - runs every 5 minutes and checks if sync is needed -->
    <record id="ir_cron_auto_sync_customers" model="ir.cron">
        <field name="name">BigCommerce: Auto Sync Customers</field>
        <field name="model_id" ref="bigcommerce_connector.model_bigcommerce_config"/>
        <field name="state">code</field>
        <field name="code">env['bigcommerce.config']._cron_auto_sync_customers()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <!-- Cron job for auto-syncing fulfillments - runs every 5 minutes and checks if sync is needed -->
    <record id="ir_cron_auto_sync_fulfillments" model="ir.cron">
        <field name="name">BigCommerce: Auto Sync Fulfillments</field>
        <field name="model_id" ref="bigcommerce_connector.model_bigcommerce_config"/>
        <field name="state">code</field>
        <field name="code">env['bigcommerce.config']._cron_auto_sync_fulfillments()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <!-- Cron job to detect syncs that stopped unexpectedly (timeout/crash) and mark them as failed -->
    <record id="ir_cron_detect_stale_sync_operations" model="ir.cron">
        <field name="name">BigCommerce: Detect Stale Sync Operations</field>
        <field name="model_id" ref="bigcommerce_connector.model_bigcommerce_sync_operation"/>
        <field name="state">code</field>
        <field name="code">env['bigcommerce.sync.operation']._cron_detect_stale_sync_operations()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
        <field name="priority">5</field>
    </record>
</odoo>

