<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bigcommerce_category_rule_form" model="ir.ui.view">
        <field name="name">bigcommerce.category.rule.form</field>
        <field name="model">bigcommerce.category.rule</field>
        <field name="arch" type="xml">
            <form string="Category Rule">
                <sheet>
                    <group>
                        <group>
                            <field name="config_id"/>
                            <field name="sequence"/>
                            <field name="filter_type"/>
                            <field name="filter_value" placeholder="e.g. IAG-APP"/>
                        </group>
                        <group>
                            <field name="odoo_category_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bigcommerce_category_rule_list" model="ir.ui.view">
        <field name="name">bigcommerce.category.rule.list</field>
        <field name="model">bigcommerce.category.rule</field>
        <field name="arch" type="xml">
            <list string="Category Rules" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="filter_type"/>
                <field name="filter_value"/>
                <field name="odoo_category_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>
</odoo>
