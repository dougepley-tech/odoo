<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bigcommerce_product_sync_form" model="ir.ui.view">
        <field name="name">bigcommerce.product.sync.form</field>
        <field name="model">bigcommerce.product.sync</field>
        <field name="arch" type="xml">
            <form string="Product Sync">
                <header>
                    <button name="action_sync_products" string="Start Sync" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel_sync" string="Cancel" type="object" class="btn-danger" invisible="state != 'running'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="config_id"/>
                            <field name="sync_date"/>
                            <field name="sync_direction"/>
                            <field name="sync_images"/>
                        </group>
                        <group>
                            <field name="products_created"/>
                            <field name="products_updated"/>
                            <field name="products_failed"/>
                        </group>
                    </group>
                    <group string="Progress" invisible="state != 'running'">
                        <field name="current_item" readonly="1" nolabel="1" placeholder="Waiting to start..."/>
                        <field name="progress_percentage" widget="progressbar" invisible="not total_items"/>
                        <group invisible="not total_items">
                            <group>
                                <label for="processed_items" string="Processed:"/>
                                <field name="processed_items" readonly="1" nolabel="1"/>
                                <span>/</span>
                                <field name="total_items" readonly="1" nolabel="1"/>
                            </group>
                        </group>
                    </group>
                    <group string="Filters" invisible="full_sync and sync_direction == 'bc_to_odoo'">
                        <field name="date_from" invisible="full_sync and sync_direction == 'bc_to_odoo'"/>
                        <field name="date_to" invisible="full_sync and sync_direction == 'bc_to_odoo'"/>
                        <field name="min_date_modified" invisible="full_sync and sync_direction == 'bc_to_odoo'"/>
                    </group>
                    <group string="Full Sync Options" invisible="sync_direction != 'bc_to_odoo'">
                        <field name="full_sync" 
                               options="{'no_create': True, 'no_create_edit': True}"
                               help="When enabled, syncs ALL products from BigCommerce regardless of modification date. Updates existing products and creates new ones. Ignores last successful sync time."/>
                    </group>
                    <group string="Specific Product Sync" invisible="sync_direction != 'bc_to_odoo' or full_sync">
                        <field name="sync_specific_product" 
                               options="{'no_create': True, 'no_create_edit': True}"
                               help="When enabled, syncs only a single product identified by SKU or BigCommerce ID."/>
                        <field name="product_sku" invisible="not sync_specific_product"
                               placeholder="Enter SKU or internal reference"
                               help="Enter the SKU or internal reference of the product to sync"/>
                        <field name="product_bigcommerce_id" invisible="not sync_specific_product"
                               placeholder="Enter BigCommerce Product ID"
                               help="Enter the BigCommerce product ID to sync"/>
                    </group>
                    <group string="Error Information" invisible="state != 'error'">
                        <field name="error_message" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bigcommerce_product_sync_list" model="ir.ui.view">
        <field name="name">bigcommerce.product.sync.list</field>
        <field name="model">bigcommerce.product.sync</field>
        <field name="arch" type="xml">
            <list string="Product Syncs">
                <field name="name"/>
                <field name="config_id"/>
                <field name="sync_date"/>
                <field name="sync_direction"/>
                <field name="state"/>
                <field name="products_created"/>
                <field name="products_updated"/>
            </list>
        </field>
    </record>

    <record id="bigcommerce_connector.action_bigcommerce_product_sync" model="ir.actions.act_window">
        <field name="name">Product Syncs</field>
        <field name="res_model">bigcommerce.product.sync</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Extend standard product search (Inventory > Products) so "BigCommerce configuration is not set" works -->
    <record id="product_template_search_view_inherit_bigcommerce" model="ir.ui.view">
        <field name="name">product.template.search.bigcommerce</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="BigCommerce configuration is not set" name="bigcommerce_configuration_not_set" domain="[('bigcommerce_mapping_ids', '=', False)]" help="Products with no BigCommerce mapping (did not sync from BigCommerce)"/>
            </xpath>
        </field>
    </record>

    <!-- Extend product template view (BigCommerce block visible only to BigCommerce Manager) -->
    <record id="product_template_form_view_inherit_bigcommerce" model="ir.ui.view">
        <field name="name">product.template.form.bigcommerce</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Add sync buttons after title, before options (BigCommerce Manager only) -->
            <xpath expr="//div[@name='options']" position="before">
                <div class="d-flex gap-2 mb-3" invisible="not bigcommerce_mapping_ids" groups="bigcommerce_connector.group_bigcommerce_manager">
                    <button name="action_sync_to_bigcommerce" string="Sync to BigCommerce" type="object" 
                            class="btn-primary" invisible="not bigcommerce_mapping_ids"/>
                    <button name="action_sync_from_bigcommerce" string="Sync from BigCommerce" type="object" 
                            class="btn-secondary" invisible="not bigcommerce_mapping_ids"/>
                    <button name="action_sync_inventory_to_bigcommerce" string="Sync Inventory to BigCommerce" type="object" 
                            class="btn-info" invisible="not bigcommerce_mapping_ids"/>
                    <button name="action_view_in_bigcommerce" string="View in BigCommerce" type="object" 
                            class="btn-primary" invisible="not bigcommerce_mapping_ids"/>
                </div>
            </xpath>
            
            <!-- Add BigCommerce section before the notebook tabs (BigCommerce Manager only) -->
            <xpath expr="//sheet//notebook" position="before">
                <div groups="bigcommerce_connector.group_bigcommerce_manager">
                    <separator string="BIGCOMMERCE CONFIGURATIONS" invisible="not bigcommerce_mapping_ids"/>
                    <!-- Show all BigCommerce configurations for this product in a readable HTML format -->
                    <field name="bigcommerce_mappings_display" nolabel="1" widget="html" readonly="1" invisible="not bigcommerce_mapping_ids"/>
                    <!-- Product dimensions (synced from BigCommerce) -->
                    <group string="Dimensions" invisible="not bigcommerce_mapping_ids">
                        <group>
                            <field name="product_length" string="Length"/>
                            <field name="product_width" string="Width"/>
                        </group>
                        <group>
                            <field name="product_height" string="Height"/>
                        </group>
                    </group>
                    <!-- Also include the tree view for detailed editing if needed (hidden by default, can be shown via debug mode) -->
                    <field name="bigcommerce_mapping_ids" nolabel="1" readonly="1" invisible="1" context="{'default_product_tmpl_id': id}" 
                           view_ref="bigcommerce_connector.view_bigcommerce_product_mapping_tree_simple"/>
                    <!-- Legacy fields for backward compatibility (computed from mappings) -->
                    <!-- Note: bigcommerce_config_id, bigcommerce_id, bigcommerce_id_display have groups='base.group_no_one' 
                         and cannot be accessed by normal users, so they're excluded from the view -->
                    <field name="bigcommerce_synced" invisible="1"/>
                    <field name="bigcommerce_last_sync" invisible="1"/>
                </div>
            </xpath>
            <!-- Product Description section: entire block above the Internal Notes group (BC description only; Internal notes cleared on sync) -->
            <xpath expr="//field[@name='description']/parent::*" position="before">
                <group string="Product Description">
                    <field name="product_description" nolabel="1" colspan="4" placeholder="Product description (synced from BigCommerce). Internal notes are in the section below."/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- BigCommerce Products List View -->
    <record id="view_bigcommerce_products_list" model="ir.ui.view">
        <field name="name">bigcommerce.products.list</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list string="BigCommerce Products">
                <field name="name"/>
                <field name="default_code"/>
                <field name="list_price"/>
                <field name="product_tag_ids" widget="many2many_tags"/>
                <field name="bigcommerce_synced"/>
                <field name="bigcommerce_last_sync"/>
            </list>
        </field>
    </record>

    <!-- BigCommerce Products Search View -->
    <record id="view_bigcommerce_products_search" model="ir.ui.view">
        <field name="name">bigcommerce.products.search</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <search string="BigCommerce Products">
                <field name="name" filter_domain="['|', '|', ('default_code', 'ilike', self), ('name', 'ilike', self), ('barcode', 'ilike', self)]"/>
                <field name="default_code"/>
                <field name="barcode"/>
                <field name="bc_product_id_search"/>
                <separator/>
                <filter string="Synced" name="bigcommerce_synced" domain="[('bigcommerce_synced', '=', True)]"/>
                <filter string="Not Synced" name="bigcommerce_not_synced" domain="[('bigcommerce_synced', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- BigCommerce Products Action -->
    <record id="bigcommerce_connector.action_bigcommerce_products" model="ir.actions.act_window">
        <field name="name">BigCommerce Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_bigcommerce_products_list"/>
        <field name="search_view_id" ref="view_bigcommerce_products_search"/>
        <field name="domain">[('bigcommerce_mapping_ids', '!=', False)]</field>
        <field name="context">{'search_default_bigcommerce_synced': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No BigCommerce products found!
            </p>
            <p>
                Products synced with BigCommerce will appear here.
            </p>
        </field>
    </record>

    <!-- BigCommerce Product Variants List View (light list: no tags in list to avoid N+1 and slow load) -->
    <record id="view_bigcommerce_product_variants_list" model="ir.ui.view">
        <field name="name">bigcommerce.product.variants.list</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <list string="BigCommerce Product Variants">
                <field name="name"/>
                <field name="default_code"/>
                <field name="list_price"/>
                <field name="product_tmpl_id"/>
                <field name="bigcommerce_variant_id"/>
            </list>
        </field>
    </record>

    <!-- BigCommerce Product Variants Search View -->
    <record id="view_bigcommerce_product_variants_search" model="ir.ui.view">
        <field name="name">bigcommerce.product.variants.search</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <search string="BigCommerce Product Variants">
                <field name="name" filter_domain="['|', '|', ('default_code', 'ilike', self), ('name', 'ilike', self), ('barcode', 'ilike', self)]"/>
                <field name="default_code"/>
                <field name="barcode"/>
                <field name="bigcommerce_variant_id"/>
                <field name="product_tmpl_id"/>
                <filter string="Has BigCommerce ID" name="bigcommerce_variants" domain="[('bigcommerce_variant_id', '!=', False)]"/>
            </search>
        </field>
    </record>

    <!-- BigCommerce Product Variants Action -->
    <record id="bigcommerce_connector.action_bigcommerce_product_variants" model="ir.actions.act_window">
        <field name="name">BigCommerce Product Variants</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_bigcommerce_product_variants_list"/>
        <field name="search_view_id" ref="view_bigcommerce_product_variants_search"/>
        <field name="domain">[('product_tmpl_id.bigcommerce_mapping_ids', '!=', False)]</field>
        <field name="context">{'search_default_bigcommerce_variants': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No BigCommerce product variants found!
            </p>
            <p>
                Product variants synced with BigCommerce will appear here.
            </p>
        </field>
    </record>

    <!-- Extend product variant form view to add sync buttons -->
    <!-- Note: Variants are typically edited within the product template view, but we can add buttons to standalone variant views -->
    <!-- Product variant form view - buttons are handled by product.template view inheritance -->
    
    <!-- Server Action: Bulk Update from BigCommerce -->
    <record id="action_server_bulk_update_from_bigcommerce" model="ir.actions.server">
        <field name="name">Update from BigCommerce</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.action_bulk_sync_from_bigcommerce()
        </field>
    </record>
</odoo>
