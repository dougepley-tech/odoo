<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- BigCommerce Product Mapping List View -->
    <record id="view_bigcommerce_product_mapping_list" model="ir.ui.view">
        <field name="name">bigcommerce.product.mapping.list</field>
        <field name="model">bigcommerce.product.mapping</field>
        <field name="arch" type="xml">
            <list string="BigCommerce Product Mappings">
                <field name="product_tmpl_id"/>
                <field name="config_id"/>
                <field name="bigcommerce_id"/>
                <field name="bigcommerce_synced"/>
                <field name="bigcommerce_last_sync" widget="datetime"/>
            </list>
        </field>
    </record>

    <!-- Simple list view for use in product template form -->
    <record id="view_bigcommerce_product_mapping_tree_simple" model="ir.ui.view">
        <field name="name">bigcommerce.product.mapping.tree.simple</field>
        <field name="model">bigcommerce.product.mapping</field>
        <field name="arch" type="xml">
            <list string="BigCommerce Configurations" create="0" delete="0" default_order="config_id" decoration-info="bigcommerce_synced == True" decoration-muted="bigcommerce_synced == False">
                <field name="config_id" string="Configuration" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="bigcommerce_id" string="BigCommerce Product ID"/>
                <field name="bigcommerce_synced" string="Synced" widget="boolean_toggle"/>
                <field name="bigcommerce_last_sync" string="Last Sync" widget="datetime"/>
            </list>
        </field>
    </record>
    
    <!-- Form view for inline display in product template (more readable) -->
    <record id="view_bigcommerce_product_mapping_form_simple" model="ir.ui.view">
        <field name="name">bigcommerce.product.mapping.form.simple</field>
        <field name="model">bigcommerce.product.mapping</field>
        <field name="arch" type="xml">
            <form string="BigCommerce Configuration" create="0" delete="0">
                <group>
                    <group>
                        <field name="config_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="bigcommerce_id"/>
                    </group>
                    <group>
                        <field name="bigcommerce_synced" widget="boolean_toggle"/>
                        <field name="bigcommerce_last_sync" widget="datetime"/>
                    </group>
                </group>
            </form>
        </field>
    </record>

    <!-- BigCommerce Product Mapping Form View -->
    <record id="view_bigcommerce_product_mapping_form" model="ir.ui.view">
        <field name="name">bigcommerce.product.mapping.form</field>
        <field name="model">bigcommerce.product.mapping</field>
        <field name="arch" type="xml">
            <form string="BigCommerce Product Mapping">
                <sheet>
                    <group>
                        <group>
                            <field name="product_tmpl_id"/>
                            <field name="config_id"/>
                            <field name="bigcommerce_id"/>
                        </group>
                        <group>
                            <field name="bigcommerce_synced"/>
                            <field name="bigcommerce_last_sync" widget="datetime"/>
                        </group>
                    </group>
                    <group string="Variant Mappings">
                        <field name="variant_mapping_ids" nolabel="1" view_ref="bigcommerce_connector.view_bigcommerce_variant_mapping_tree_simple"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- BigCommerce Product Mapping Search View -->
    <record id="view_bigcommerce_product_mapping_search" model="ir.ui.view">
        <field name="name">bigcommerce.product.mapping.search</field>
        <field name="model">bigcommerce.product.mapping</field>
        <field name="arch" type="xml">
            <search string="BigCommerce Product Mappings">
                <field name="product_tmpl_id"/>
                <field name="config_id"/>
                <field name="bigcommerce_id"/>
                <filter string="Synced" name="synced" domain="[('bigcommerce_synced', '=', True)]"/>
                <filter string="Not Synced" name="not_synced" domain="[('bigcommerce_synced', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- BigCommerce Product Mapping Action -->
    <record id="action_bigcommerce_product_mapping" model="ir.actions.act_window">
        <field name="name">BigCommerce Product Mappings</field>
        <field name="res_model">bigcommerce.product.mapping</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_bigcommerce_product_mapping_list"/>
    </record>

    <!-- BigCommerce Variant Mapping List View -->
    <record id="view_bigcommerce_variant_mapping_list" model="ir.ui.view">
        <field name="name">bigcommerce.variant.mapping.list</field>
        <field name="model">bigcommerce.variant.mapping</field>
        <field name="arch" type="xml">
            <list string="BigCommerce Variant Mappings">
                <field name="product_variant_id"/>
                <field name="product_mapping_id"/>
                <field name="config_id"/>
                <field name="bigcommerce_variant_id"/>
            </list>
        </field>
    </record>

    <!-- BigCommerce Variant Mapping Form View -->
    <record id="view_bigcommerce_variant_mapping_form" model="ir.ui.view">
        <field name="name">bigcommerce.variant.mapping.form</field>
        <field name="model">bigcommerce.variant.mapping</field>
        <field name="arch" type="xml">
            <form string="BigCommerce Variant Mapping">
                <sheet>
                    <group>
                        <group>
                            <field name="product_variant_id"/>
                            <field name="product_mapping_id"/>
                            <field name="config_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="bigcommerce_variant_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- BigCommerce Variant Mapping Search View -->
    <record id="view_bigcommerce_variant_mapping_search" model="ir.ui.view">
        <field name="name">bigcommerce.variant.mapping.search</field>
        <field name="model">bigcommerce.variant.mapping</field>
        <field name="arch" type="xml">
            <search string="BigCommerce Variant Mappings">
                <field name="product_variant_id"/>
                <field name="product_mapping_id"/>
                <field name="config_id"/>
                <field name="bigcommerce_variant_id"/>
            </search>
        </field>
    </record>

    <!-- BigCommerce Variant Mapping Action -->
    <record id="action_bigcommerce_variant_mapping" model="ir.actions.act_window">
        <field name="name">BigCommerce Variant Mappings</field>
        <field name="res_model">bigcommerce.variant.mapping</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_bigcommerce_variant_mapping_list"/>
    </record>

    <!-- Simple list view for variant mappings in product mapping form -->
    <record id="view_bigcommerce_variant_mapping_tree_simple" model="ir.ui.view">
        <field name="name">bigcommerce.variant.mapping.tree.simple</field>
        <field name="model">bigcommerce.variant.mapping</field>
        <field name="arch" type="xml">
            <list string="Variant Mappings" create="0" delete="0">
                <field name="product_variant_id"/>
                <field name="bigcommerce_variant_id"/>
            </list>
        </field>
    </record>
</odoo>
