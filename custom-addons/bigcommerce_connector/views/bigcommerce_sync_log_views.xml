<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bigcommerce_sync_log_list" model="ir.ui.view">
        <field name="name">bigcommerce.sync.log.list</field>
        <field name="model">bigcommerce.sync.log</field>
        <field name="arch" type="xml">
            <list string="Sync Logs" default_order="log_date desc" decoration-danger="log_level == 'error'" decoration-warning="log_level == 'warning'" decoration-info="log_level == 'info'">
                <field name="log_date"/>
                <field name="log_level" widget="badge" decoration-success="log_level == 'info'" decoration-warning="log_level == 'warning'" decoration-danger="log_level == 'error'"/>
                <field name="sync_type"/>
                <field name="sync_operation_id" optional="show"/>
                <field name="config_id"/>
                <field name="message"/>
                <field name="product_id" optional="hide"/>
                <field name="product_name" optional="hide"/>
                <field name="sale_order_id" optional="hide" string="Odoo Order"/>
                <field name="response_status" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_bigcommerce_sync_log_form" model="ir.ui.view">
        <field name="name">bigcommerce.sync.log.form</field>
        <field name="model">bigcommerce.sync.log</field>
        <field name="arch" type="xml">
            <form string="Sync Log">
                <header>
                    <button name="action_clear_logs" string="Clear Old Logs" type="object" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="log_date" readonly="1"/>
                            <field name="log_level" readonly="1"/>
                            <field name="sync_type" readonly="1"/>
                            <field name="sync_operation_id" readonly="1"/>
                            <field name="config_id" readonly="1"/>
                            <field name="sync_record_id" readonly="1"/>
                        </group>
                        <group>
                            <group invisible="sync_type != 'order'">
                                <field name="product_id" readonly="1" string="BigCommerce Order ID"/>
                                <field name="sale_order_id" readonly="1" string="Odoo Order" options="{'open': True}"/>
                            </group>
                            <group invisible="sync_type == 'order'">
                                <field name="product_id" readonly="1"/>
                                <field name="product_name" readonly="1"/>
                            </group>
                            <field name="request_method" readonly="1"/>
                            <field name="request_url" readonly="1"/>
                            <field name="response_status" readonly="1"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="message" nolabel="1" readonly="1"/>
                    </group>
                    <group string="Error Details" invisible="not error_details">
                        <field name="error_details" nolabel="1" readonly="1" widget="text"/>
                    </group>
                    <group string="Request/Response Details" invisible="not request_url">
                        <field name="request_url" readonly="1"/>
                        <field name="request_method" readonly="1"/>
                        <field name="response_status" readonly="1"/>
                        <field name="response_data" readonly="1" widget="text" invisible="not response_data"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bigcommerce_sync_log_search" model="ir.ui.view">
        <field name="name">bigcommerce.sync.log.search</field>
        <field name="model">bigcommerce.sync.log</field>
        <field name="arch" type="xml">
            <search string="Sync Logs">
                <field name="message"/>
                <field name="product_name"/>
                <field name="sync_operation_id"/>
                <field name="config_id"/>
                <filter string="Errors Only" name="errors" domain="[('log_level', '=', 'error')]"/>
                <filter string="Warnings" name="warnings" domain="[('log_level', '=', 'warning')]"/>
                <separator/>
                <filter string="Products" name="products" domain="[('sync_type', '=', 'product')]"/>
                <filter string="Orders" name="orders" domain="[('sync_type', '=', 'order')]"/>
                <filter string="Inventory" name="inventory" domain="[('sync_type', '=', 'inventory')]"/>
                <filter string="Customers" name="customers" domain="[('sync_type', '=', 'customer')]"/>
                <filter string="Fulfillment" name="fulfillment" domain="[('sync_type', '=', 'fulfillment')]"/>
            </search>
        </field>
    </record>

    <record id="bigcommerce_connector.action_bigcommerce_sync_log" model="ir.actions.act_window">
        <field name="name">Sync Logs</field>
        <field name="res_model">bigcommerce.sync.log</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('log_level', 'in', ['error', 'warning'])]</field>
        <field name="context">{'search_default_errors': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No errors or warnings!
            </p>
            <p>
                Sync logs will appear here when sync operations run. Check the filters to see all logs.
            </p>
        </field>
    </record>
</odoo>

