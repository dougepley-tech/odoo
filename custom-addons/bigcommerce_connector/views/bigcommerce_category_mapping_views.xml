<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bigcommerce_category_mapping_form" model="ir.ui.view">
        <field name="name">bigcommerce.category.mapping.form</field>
        <field name="model">bigcommerce.category.mapping</field>
        <field name="arch" type="xml">
            <form string="Category Mapping">
                <sheet>
                    <group>
                        <group>
                            <field name="config_id"/>
                            <field name="bc_category_id"/>
                            <field name="bc_category_name"/>
                        </group>
                        <group>
                            <field name="odoo_category_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bigcommerce_category_mapping_list" model="ir.ui.view">
        <field name="name">bigcommerce.category.mapping.list</field>
        <field name="model">bigcommerce.category.mapping</field>
        <field name="arch" type="xml">
            <list string="Category Mappings">
                <field name="bc_category_id"/>
                <field name="bc_category_name"/>
                <field name="odoo_category_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_bigcommerce_category_mapping_search" model="ir.ui.view">
        <field name="name">bigcommerce.category.mapping.search</field>
        <field name="model">bigcommerce.category.mapping</field>
        <field name="arch" type="xml">
            <search string="Category Mappings">
                <field name="bc_category_name"/>
                <field name="odoo_category_id"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_bigcommerce_category_mapping" model="ir.actions.act_window">
        <field name="name">Category Mappings</field>
        <field name="res_model">bigcommerce.category.mapping</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a category mapping
            </p>
            <p>
                Map BigCommerce categories to Odoo product categories.
            </p>
        </field>
    </record>
</odoo>

