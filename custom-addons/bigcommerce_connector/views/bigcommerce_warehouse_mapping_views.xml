<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bigcommerce_warehouse_mapping_form" model="ir.ui.view">
        <field name="name">bigcommerce.warehouse.mapping.form</field>
        <field name="model">bigcommerce.warehouse.mapping</field>
        <field name="arch" type="xml">
            <form string="Warehouse Mapping">
                <sheet>
                    <group>
                        <group>
                            <field name="config_id"/>
                            <field name="odoo_warehouse_id"/>
                            <field name="is_default"/>
                        </group>
                        <group>
                            <field name="bc_location_id"/>
                            <field name="bc_location_name"/>
                            <field name="min_threshold"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bigcommerce_warehouse_mapping_list" model="ir.ui.view">
        <field name="name">bigcommerce.warehouse.mapping.list</field>
        <field name="model">bigcommerce.warehouse.mapping</field>
        <field name="arch" type="xml">
            <list string="Warehouse Mappings">
                <field name="odoo_warehouse_id"/>
                <field name="bc_location_name"/>
                <field name="is_default"/>
                <field name="min_threshold"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_bigcommerce_warehouse_mapping_search" model="ir.ui.view">
        <field name="name">bigcommerce.warehouse.mapping.search</field>
        <field name="model">bigcommerce.warehouse.mapping</field>
        <field name="arch" type="xml">
            <search string="Warehouse Mappings">
                <field name="odoo_warehouse_id"/>
                <field name="bc_location_name"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Default" name="default" domain="[('is_default', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_bigcommerce_warehouse_mapping" model="ir.actions.act_window">
        <field name="name">Warehouse Mappings</field>
        <field name="res_model">bigcommerce.warehouse.mapping</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a warehouse mapping
            </p>
            <p>
                Map Odoo warehouses to BigCommerce locations for multi-warehouse inventory sync.
            </p>
        </field>
    </record>
</odoo>

