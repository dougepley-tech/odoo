<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bigcommerce_state_tax_mapping_form" model="ir.ui.view">
        <field name="name">bigcommerce.state.tax.mapping.form</field>
        <field name="model">bigcommerce.state.tax.mapping</field>
        <field name="arch" type="xml">
            <form string="State Tax Mapping">
                <sheet>
                    <group>
                        <field name="config_id"/>
                        <field name="state_code"/>
                        <field name="state_name"/>
                        <field name="tax_product_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bigcommerce_state_tax_mapping_list" model="ir.ui.view">
        <field name="name">bigcommerce.state.tax.mapping.list</field>
        <field name="model">bigcommerce.state.tax.mapping</field>
        <field name="arch" type="xml">
            <list string="State Tax Mappings">
                <field name="state_code"/>
                <field name="state_name"/>
                <field name="tax_product_id"/>
                <field name="config_id"/>
            </list>
        </field>
    </record>

    <record id="view_bigcommerce_state_tax_mapping_search" model="ir.ui.view">
        <field name="name">bigcommerce.state.tax.mapping.search</field>
        <field name="model">bigcommerce.state.tax.mapping</field>
        <field name="arch" type="xml">
            <search string="State Tax Mappings">
                <field name="state_code"/>
                <field name="state_name"/>
                <field name="config_id"/>
            </search>
        </field>
    </record>

    <record id="action_bigcommerce_state_tax_mapping" model="ir.actions.act_window">
        <field name="name">State Tax Mappings</field>
        <field name="res_model">bigcommerce.state.tax.mapping</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_bigcommerce_carrier_mapping_form" model="ir.ui.view">
        <field name="name">bigcommerce.carrier.mapping.form</field>
        <field name="model">bigcommerce.carrier.mapping</field>
        <field name="arch" type="xml">
            <form string="Carrier Mapping">
                <sheet>
                    <group>
                        <field name="config_id"/>
                        <field name="odoo_carrier_id"/>
                        <field name="bc_carrier_code"/>
                        <field name="priority"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bigcommerce_carrier_mapping_list" model="ir.ui.view">
        <field name="name">bigcommerce.carrier.mapping.list</field>
        <field name="model">bigcommerce.carrier.mapping</field>
        <field name="arch" type="xml">
            <list string="Carrier Mappings">
                <field name="odoo_carrier_id"/>
                <field name="bc_carrier_code"/>
                <field name="priority"/>
                <field name="config_id"/>
            </list>
        </field>
    </record>

    <record id="view_bigcommerce_carrier_mapping_search" model="ir.ui.view">
        <field name="name">bigcommerce.carrier.mapping.search</field>
        <field name="model">bigcommerce.carrier.mapping</field>
        <field name="arch" type="xml">
            <search string="Carrier Mappings">
                <field name="odoo_carrier_id"/>
                <field name="bc_carrier_code"/>
                <field name="config_id"/>
            </search>
        </field>
    </record>

    <record id="action_bigcommerce_carrier_mapping" model="ir.actions.act_window">
        <field name="name">Carrier Mappings</field>
        <field name="res_model">bigcommerce.carrier.mapping</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

