<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_partner_form_fishbowl_historical_orders" model="ir.ui.view">
    <field name="name">res.partner.form.fishbowl.historical.orders</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page name="fishbowl_historical_orders" string="Fishbowl History">
          <div class="mb-3">
            <button name="action_import_fishbowl_orders" string="Import Fishbowl Orders" type="object" class="btn-primary"/>
          </div>
          <field name="fishbowl_historical_order_count" invisible="True"/>
          <field name="fishbowl_historical_order_ids" nolabel="1" readonly="1" context="{'default_partner_id': id}">
            <list decoration-muted="state in ('void', 'cancelled', 'expired')" create="0" delete="0" open_form_view="1">
              <field name="fishbowl_order_num"/>
              <field name="order_date"/>
              <field name="customer_po"/>
              <field name="state"/>
              <field name="line_count"/>
            </list>
          </field>
        </page>
      </xpath>
    </field>
  </record>

</odoo>
