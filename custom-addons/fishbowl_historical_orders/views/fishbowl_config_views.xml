<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_fishbowl_config_form" model="ir.ui.view">
    <field name="name">fishbowl.config.form</field>
    <field name="model">fishbowl.config</field>
    <field name="arch" type="xml">
      <form string="Fishbowl Connection">
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_test_connection" type="object" class="oe_stat_button" icon="fa-plug" string="Test Connection"/>
          </div>
          <group>
            <group>
              <field name="host"/>
              <field name="port"/>
              <field name="database"/>
            </group>
            <group>
              <field name="user"/>
              <field name="password" password="True"/>
              <field name="active"/>
              <field name="company_id" groups="base.group_multi_company"/>
            </group>
          </group>
          <div class="alert alert-info" role="alert">
            This connection is used by the Fishbowl Historical Orders import wizard to read from the SO, SOITEM, and CUSTOMER tables. Ensure the database user has SELECT access. No accounting or sales orders are created in Odoo.
          </div>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_fishbowl_config_tree" model="ir.ui.view">
    <field name="name">fishbowl.config.tree</field>
    <field name="model">fishbowl.config</field>
    <field name="arch" type="xml">
      <list string="Fishbowl Connections" decoration-muted="active == False">
        <field name="host"/>
        <field name="database"/>
        <field name="user"/>
        <field name="active"/>
      </list>
    </field>
  </record>

  <record id="action_fishbowl_config" model="ir.actions.act_window">
    <field name="name">Fishbowl Connection</field>
    <field name="res_model">fishbowl.config</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        No Fishbowl connection configured.
      </p>
      <p>
        Create a connection to your Fishbowl MySQL database (host, port, database, user, password). Then use Sales → Fishbowl Historical Orders → Import to pull historical orders.
      </p>
    </field>
  </record>

  <menuitem id="menu_fishbowl_config"
            name="Connection"
            action="action_fishbowl_config"
            parent="menu_fishbowl_root"
            sequence="5"/>

</odoo>
