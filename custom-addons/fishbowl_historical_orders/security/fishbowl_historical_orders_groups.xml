<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="module_category_fishbowl_historical_orders" model="ir.module.category">
    <field name="name">Fishbowl Historical Orders</field>
  </record>

  <record id="privilege_fishbowl_historical_orders" model="res.groups.privilege">
    <field name="name">Fishbowl Historical Orders</field>
    <field name="category_id" ref="module_category_fishbowl_historical_orders"/>
  </record>

  <record id="group_fishbowl_historical_orders_admin" model="res.groups">
    <field name="name">Administrator</field>
    <field name="privilege_id" ref="privilege_fishbowl_historical_orders"/>
    <field name="comment">Can access Fishbowl configuration (connections). Other users can only import and view historical orders.</field>
  </record>
</odoo>
