<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_fishbowl_import_wizard_form" model="ir.ui.view">
    <field name="name">fishbowl.import.wizard.form</field>
    <field name="model">fishbowl.import.wizard</field>
    <field name="arch" type="xml">
      <form string="Import Fishbowl Historical Orders">
        <group invisible="state == 'done'">
          <group string="Date range (optional when using search)">
            <field name="config_id"/>
            <field name="date_from"/>
            <field name="date_to"/>
            <field name="batch_size"/>
          </group>
          <group string="Search (import by criteria instead of date range)">
            <field name="fishbowl_so_number" placeholder="e.g. 215216"/>
            <field name="customer_po" placeholder="Customer PO number"/>
            <field name="customer_email" placeholder="Customer email"/>
            <field name="customer_name" placeholder="Customer or Bill To name"/>
            <field name="customer_phone" placeholder="Phone number"/>
          </group>
        </group>
        <group invisible="state != 'done'">
          <field name="result_message" nolabel="1"/>
        </group>
        <field name="state" invisible="True"/>
        <footer invisible="state == 'done'">
          <button name="action_import" string="Import" type="object" class="btn-primary"/>
          <button string="Cancel" class="btn-secondary" special="cancel"/>
        </footer>
        <footer invisible="state != 'done'">
          <button string="Close" class="btn-primary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_fishbowl_import_wizard" model="ir.actions.act_window">
    <field name="name">Import from Fishbowl</field>
    <field name="res_model">fishbowl.import.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <menuitem id="menu_fishbowl_import"
            name="Import Orders"
            action="action_fishbowl_import_wizard"
            parent="menu_fishbowl_root"
            sequence="10"/>

</odoo>
